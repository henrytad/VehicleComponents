test component TireTestRig
  """
  Tire test rig.
  
  Mounts the wheel centre at the unloaded radius, then sweeps it vertically.
  
  With `speed` non-zero the carriage also rolls the wheel forward while the
  spin drive ramps wheel speed from `kappa_start` to `kappa_end`, which walks
  the tire across its slip curve at a held vertical load.
  
  The steer drive does the same for slip angle, ramping from `alpha_start` to
  `alpha_end`. The carriage always travels along world x, so steering the wheel
  left puts the contact patch's lateral velocity along -y_c, which is a negative
  slip angle: `steer.phi` is the negative of the commanded slip angle.
  """

  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}

  tire = VehicleComponents.TireMF61(
    is_left = true,
    unloaded_radius = unloaded_radius
  ) {^tire}
  
  # Mount. Sitting the mount low by `static_deflection` preloads the tyre at
  # t = 0 instead of stepping the position source, which would fight the
  # initial condition.
  mount = MultibodyComponents.FixedTranslation(r = [0, 0, unloaded_radius - static_deflection], render = false) {^mount}
  carriage = MultibodyComponents.Prismatic(n = [1, 0, 0], render = false) {^carriage}
  carriage_position = TranslationalComponents.Sources.Position() {^carriage_position}
  prismatic = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^prismatic}
  wheel_position = TranslationalComponents.Sources.Position() {^wheel_position}

  # Steer drive
  steer = MultibodyComponents.Revolute(n = [0, 0, 1], render = false) {^steer}
  steer_position = RotationalComponents.Sources.Position() {^steer_position}

  # Spin drive
  spin = RotationalComponents.Sources.Position() {^spin}
  spin_ground = RotationalComponents.Components.Fixed() {^spin_ground}

  # Shared reference
  parameter unloaded_radius::Length = VehicleComponents.params.tires.UNLOADED_RADIUS

  # Excitation
  parameter stroke::Length = 0.0254
  parameter freq::Frequency = 0.5

  parameter speed::Velocity = 0.0
  parameter static_deflection::Length = 0.0
  parameter kappa_start::Real = 0.0
  parameter kappa_end::Real = 0.0
  parameter slip_ramp_time::Time = 1.0

  parameter alpha_start::Angle = 0.0
  parameter alpha_end::Angle = 0.0
  parameter steer_ramp_time::Time = 1.0

  final parameter spin_rate_start::AngularVelocity = (1 + kappa_start) * speed / unloaded_radius
  final parameter spin_accel::AngularAcceleration = (kappa_end - kappa_start) * speed / (unloaded_radius * slip_ramp_time)
  final parameter alpha_rate::AngularVelocity = (alpha_end - alpha_start) / steer_ramp_time

relations

  initial wheel_position.v = 0.0
  initial carriage_position.v = speed
  initial spin.w = spin_rate_start
  initial steer_position.w = -alpha_rate

  wheel_position.s_ref = stroke * sin(2 * π * freq * time)
  carriage_position.s_ref = speed * time
  spin.phi_ref = spin_rate_start * time + 0.5 * spin_accel * time ^ 2
  steer_position.phi_ref = -(alpha_start + alpha_rate * time)

  connect(world.frame_b, mount.frame_a) {^id12}
  connect(mount.frame_b, carriage.frame_a) {^id13}
  connect(carriage.support, carriage_position.support) {^id14}
  connect(carriage_position.flange, carriage.axis) {^id15}
  connect(carriage.frame_b, prismatic.frame_a) {^id16}
  connect(prismatic.support, wheel_position.support) {^id17}
  connect(wheel_position.flange, prismatic.axis) {^id18}
  connect(prismatic.frame_b, steer.frame_a) {^id19}
  connect(steer.support, steer_position.support) {^id20}
  connect(steer_position.spline, steer.axis) {^id21}
  connect(steer.frame_b, tire.wheel_center) {^id22}
  connect(spin.spline, tire.spline) {^id23}
  connect(spin_ground.spline, spin.support) {^id24}

metadata {
  "Dyad": {
    "experiments": {},
    "tests": {
      "sweep": {
        "stop": 2,
        "atol": {"tire.rho": 0.000001, "tire.Fz": 0.01, "tire.loaded_radius": 0.000001},
        "expect": {
          "initial": {"tire.rho": 0, "tire.Fz": 0, "tire.loaded_radius": 0.344},
          "signals": ["tire.rho", "tire.Fz", "tire.loaded_radius", "tire.z_w"]
        }
      },
      "slip": {
        "stop": 2,
        "params": {
          "speed": 10,
          "static_deflection": 0.005,
          "stroke": 0,
          "kappa_start": -0.2,
          "kappa_end": 0.2,
          "slip_ramp_time": 2
        },
        "atol": {"tire.kappa": 0.0001, "tire.Fx": 0.1, "tire.Fz": 0.1, "tire.rho": 0.000001},
        "expect": {
          "initial": {"tire.rho": 0.005, "tire.Fz": 1050},
          "signals": ["tire.kappa", "tire.Fx", "tire.Fz", "tire.rho"]
        }
      },
      "slip_angle": {
        "stop": 2,
        "params": {
          "speed": 10,
          "static_deflection": 0.005,
          "stroke": 0,
          "alpha_start": -0.2,
          "alpha_end": 0.2,
          "steer_ramp_time": 2
        },
        "atol": {"tire.alpha": 0.0001, "tire.Fy": 0.1, "tire.Fx": 0.1, "tire.Fz": 0.1},
        "expect": {
          "initial": {"tire.rho": 0.005, "tire.Fz": 1050, "tire.alpha": -0.2},
          "signals": ["tire.alpha", "tire.Fy", "tire.Fx", "tire.Fz"]
        }
      }
    }
  },
  "_links": {
