    "id18": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 630, "y": 360}], "E": 2}], "path": {}}},
    "mount": {
      "Dyad": {"placement": {"diagram": {"x1": 170, "x2": 270, "y1": 450, "y2": 550}}}
    },
    "prismatic": {
      "Dyad": {"placement": {"diagram": {"x1": 440, "x2": 540, "y1": 450, "y2": 550}}}
    },
    "wheel_position": {
