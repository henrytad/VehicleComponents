test component TireTestRig
  """
  Tire test rig.

  Mounts the wheel centre at the unloaded radius, then sweeps it vertically.

  With `speed` non-zero the carriage also rolls the wheel forward while the
  spin drive ramps wheel speed from `kappa_start` to `kappa_end`, which walks
  the tire across its slip curve at a held vertical load.

  The steer drive does the same for slip angle, ramping from `alpha_start` to
  `alpha_end`. The carriage always travels along world x, so steering the wheel
  left puts the contact patch's lateral velocity along -y_c, which is a negative
  slip angle: `steer.phi` is the negative of the commanded slip angle.
  """

  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}

  tire = VehicleComponents.TireMF61(
    is_left = true,
    unloaded_radius = unloaded_radius,
    width = 0.235,
    vertical_stiffness = 210000.0,
    vertical_damping = 50.0,
    longitudinal_stiffness = 358700.0,
    lateral_stiffness = 144152.0,
    FNOMIN = 4850.0,
    BREFF = 8.4,
    DREFF = 0.27,
    FREFF = 0.07,
    INFLPRES = 200000.0,
    NOMPRES = 200000.0,
    LONGVL = 16.6,
    PCX1 = 1.6411,
    PDX1 = 1.1739,
    PDX2 = -0.16395,
    PDX3 = 0.0,
    PEX1 = 0.46403,
    PEX2 = 0.25022,
    PEX3 = 0.067842,
    PEX4 = -0.000037604,
    PKX1 = 22.303,
    PKX2 = 0.48896,
    PKX3 = 0.21253,
    PHX1 = 0.0012297,
    PHX2 = 0.0004318,
    PVX1 = -0.0000088098,
    PVX2 = 0.00001862,
    PPX1 = -0.25,
    PPX2 = -0.35,
    PPX3 = 0.35,
    PPX4 = -0.75,
    RBX1 = 13.276,
    RBX2 = -13.778,
    RBX3 = 0.0,
    RCX1 = 1.2568,
    REX1 = 0.65225,
    REX2 = -0.24948,
    RHX1 = 0.0050722,
    PCY1 = 1.3507,
    PDY1 = 1.0489,
    PDY2 = -0.18033,
    PDY3 = -2.8821,
    PEY1 = -0.0074722,
    PEY2 = -0.0063208,
    PEY3 = -9.9935,
    PEY4 = -760.14,
    PEY5 = 0.0,
    PKY1 = -21.92,
    PKY2 = 2.0012,
    PKY3 = -0.024778,
    PKY4 = 2.0,
    PKY5 = 0.0,
    PKY6 = -0.88,
    PKY7 = -0.4891,
    PHY1 = 0.0026747,
    PHY2 = 0.000089094,
    PVY1 = 0.037318,
    PVY2 = -0.010049,
    PVY3 = -0.32931,
    PVY4 = -0.69553,
    PPY1 = 0.2,
    PPY2 = 0.5,
    PPY3 = 0.1225,
    PPY4 = -0.2625,
    PPY5 = 0.0,
    RBY1 = 7.1433,
    RBY2 = 9.1916,
    RBY3 = -0.027856,
    RBY4 = 0.0,
    RCY1 = 1.0719,
    REY1 = -0.27572,
    REY2 = 0.32802,
    RHY1 = 0.0000057448,
    RHY2 = -0.000031368,
    RVY1 = -0.027825,
    RVY2 = 0.053604,
    RVY3 = -0.27568,
    RVY4 = 12.12,
    RVY5 = 1.9,
    RVY6 = -10.704,
    QBZ1 = 10.904,
    QBZ2 = -1.8412,
    QBZ3 = -0.52041,
    QBZ4 = 0.039211,
    QBZ5 = 0.41511,
    QBZ6 = 0.0,
    QBZ9 = 8.9846,
    QBZ10 = 0.0,
    QCZ1 = 1.2136,
    QDZ1 = 0.093509,
    QDZ2 = -0.0092183,
    QDZ3 = -0.057061,
    QDZ4 = 0.73954,
    QDZ6 = -0.0067783,
    QDZ7 = 0.0052254,
    QDZ8 = -0.18175,
    QDZ9 = 0.029952,
    QDZ10 = 0.0,
    QDZ11 = 0.0,
    QEZ1 = -1.5697,
    QEZ2 = 0.33394,
    QEZ3 = 0.0,
    QEZ4 = 0.26711,
    QEZ5 = -3.594,
    QHZ1 = 0.0047326,
    QHZ2 = 0.0026687,
    QHZ3 = 0.11998,
    QHZ4 = 0.059083,
    PPZ1 = 0.0,
    PPZ2 = 0.0,
    SSZ1 = 0.033372,
    SSZ2 = 0.0043624,
    SSZ3 = 0.56742,
    SSZ4 = -0.24116,
    LFZO = 1.0,
    LCX = 1.0,
    LMUX = 1.0,
    LEX = 1.0,
    LKX = 1.0,
    LHX = 1.0,
    LVX = 1.0,
    LCY = 1.0,
    LMUY = 1.0,
    LEY = 1.0,
    LKY = 1.0,
    LHY = 1.0,
    LVY = 1.0,
    LKYC = 1.0,
    LXAL = 1.0,
    LYKA = 1.0,
    LVYKA = 1.0,
    LTR = 1.0,
    LRES = 1.0,
    LKZC = 1.0,
    LS = 1.0,
    LMUV = 0.0
  ) {^tire}
  
  # Mount. Sitting the mount low by `static_deflection` preloads the tyre at
  # t = 0 instead of stepping the position source, which would fight the
  # initial condition.
  mount = MultibodyComponents.FixedTranslation(r = [0, 0, unloaded_radius - static_deflection], render = false) {^mount}
  carriage = MultibodyComponents.Prismatic(n = [1, 0, 0], render = false) {^carriage}
  carriage_position = TranslationalComponents.Sources.Position() {^carriage_position}
  prismatic = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^prismatic}
  wheel_position = TranslationalComponents.Sources.Position() {^wheel_position}

  # Steer drive
  steer = MultibodyComponents.Revolute(n = [0, 0, 1], render = false) {^steer}
  steer_position = RotationalComponents.Sources.Position() {^steer_position}

  # Spin drive
  spin = RotationalComponents.Sources.Position() {^spin}
  spin_ground = RotationalComponents.Components.Fixed() {^spin_ground}

  # Shared reference
  parameter unloaded_radius::Length = 0.344

  # Excitation
  parameter stroke::Length = 0.0254
  parameter freq::Frequency = 0.5

  parameter speed::Velocity = 0.0
  parameter static_deflection::Length = 0.0
  parameter kappa_start::Real = 0.0
  parameter kappa_end::Real = 0.0
  parameter slip_ramp_time::Time = 1.0

  parameter alpha_start::Angle = 0.0
  parameter alpha_end::Angle = 0.0
  parameter steer_ramp_time::Time = 1.0

  final parameter spin_rate_start::AngularVelocity = (1 + kappa_start) * speed / unloaded_radius
  final parameter spin_accel::AngularAcceleration = (kappa_end - kappa_start) * speed / (unloaded_radius * slip_ramp_time)
  final parameter alpha_rate::AngularVelocity = (alpha_end - alpha_start) / steer_ramp_time

relations

  initial wheel_position.v = 0.0
  initial carriage_position.v = speed
  initial spin.w = spin_rate_start
  initial steer_position.w = -alpha_rate

  wheel_position.s_ref = stroke * sin(2 * π * freq * time)
  carriage_position.s_ref = speed * time
  spin.phi_ref = spin_rate_start * time + 0.5 * spin_accel * time ^ 2
  steer_position.phi_ref = -(alpha_start + alpha_rate * time)

  connect(world.frame_b, mount.frame_a) {^id6}
  connect(mount.frame_b, carriage.frame_a) {^id11}
  connect(carriage.support, carriage_position.support) {^id12}
  connect(carriage_position.flange, carriage.axis) {^id13}
  connect(carriage.frame_b, prismatic.frame_a) {^id7}
  connect(prismatic.support, wheel_position.support) {^id8}
  connect(wheel_position.flange, prismatic.axis) {^id9}
  connect(prismatic.frame_b, steer.frame_a) {^id16}
  connect(steer.support, steer_position.support) {^id17}
  connect(steer_position.spline, steer.axis) {^id18}
  connect(steer.frame_b, tire.wheel_center) {^id10}
  connect(spin.spline, tire.spline) {^id14}
  connect(spin_ground.spline, spin.support) {^id15}

metadata {
  "Dyad": {
    "experiments": {},
    "tests": {
      "sweep": {
        "stop": 2.0,
        "atol": {"tire.rho": 0.000001, "tire.Fz": 0.01, "tire.loaded_radius": 0.000001},
        "expect": {
          "initial": {"tire.rho": 0, "tire.Fz": 0, "tire.loaded_radius": 0.344},
          "signals": ["tire.rho", "tire.Fz", "tire.loaded_radius", "tire.z_w"]
        }
      },
      "slip": {
        "stop": 2.0,
        "params": {
          "speed": 10.0,
          "static_deflection": 0.005,
          "stroke": 0.0,
          "kappa_start": -0.2,
          "kappa_end": 0.2,
          "slip_ramp_time": 2.0
        },
        "atol": {
          "tire.kappa": 0.0001,
          "tire.Fx": 0.1,
          "tire.Fz": 0.1,
          "tire.rho": 0.000001
        },
        "expect": {
          "initial": {"tire.rho": 0.005, "tire.Fz": 1050.0},
          "signals": ["tire.kappa", "tire.Fx", "tire.Fz", "tire.rho"]
        }
      },
      "slip_angle": {
        "stop": 2.0,
        "params": {
          "speed": 10.0,
          "static_deflection": 0.005,
          "stroke": 0.0,
          "alpha_start": -0.2,
          "alpha_end": 0.2,
          "steer_ramp_time": 2.0
        },
        "atol": {
          "tire.alpha": 0.0001,
          "tire.Fy": 0.1,
          "tire.Fz": 0.1,
          "tire.rho": 0.000001
        },
        "expect": {
          "initial": {"tire.rho": 0.005, "tire.Fz": 1050.0, "tire.alpha": -0.2},
          "signals": ["tire.alpha", "tire.Fy", "tire.Fx", "tire.Fz"]
        }
      }
    }
  },
  "_links": {
    "world": {"Dyad": {"placement": {"diagram": {"x1": 10, "x2": 110, "y1": 10, "y2": 110}}}},
    "tire": {
      "Dyad": {"placement": {"diagram": {"x1": 730, "x2": 830, "y1": 450, "y2": 550}}}
    },
    "steer": {
