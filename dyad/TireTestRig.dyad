    "id8": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 400, "y": 550}], "E": 2}], "path": {}}},
    "id9": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 490, "y": 360}], "E": 2}], "path": {}}},
