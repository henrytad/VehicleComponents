component VehicleControl
  "Traction control with a shared drive power limit, and anti-lock brake control."

  throttle = RealInput() {^throttle}
  brake = RealInput(units = "1") {^brake}
  slip_fl = RealInput() {^slip_fl}
  slip_fr = RealInput() {^slip_fr}
  slip_rl = RealInput() {^slip_rl}
  slip_rr = RealInput() {^slip_rr}
  full_demand_power_fl = RealInput(units = "W") {^full_demand_power_fl}
  full_demand_power_fr = RealInput(units = "W") {^full_demand_power_fr}
  full_demand_power_rl = RealInput(units = "W") {^full_demand_power_rl}
  full_demand_power_rr = RealInput(units = "W") {^full_demand_power_rr}

  demand_fl = RealOutput(units = "1") {^demand_fl}
  demand_fr = RealOutput(units = "1") {^demand_fr}
  demand_rl = RealOutput(units = "1") {^demand_rl}
  demand_rr = RealOutput(units = "1") {^demand_rr}
  brake_demand = RealOutput(units = "1") {^brake_demand}

  tc = VehicleComponents.TorqueControlLaunch() {^tc}
  abs = VehicleComponents.ABSControl() {^abs}

  parameter total_max_power::Power = VehicleComponents.params.total_max_power
  variable requested_power::Power
  variable power_scale::Real

relations

  requested_power = tc.demand_fl * full_demand_power_fl + tc.demand_fr * full_demand_power_fr +
                    tc.demand_rl * full_demand_power_rl + tc.demand_rr * full_demand_power_rr
  power_scale = ifelse(requested_power > total_max_power, total_max_power / requested_power, 1)
  demand_fl = tc.demand_fl * power_scale
  demand_fr = tc.demand_fr * power_scale
  demand_rl = tc.demand_rl * power_scale
  demand_rr = tc.demand_rr * power_scale

  connect(throttle, tc.throttle) {^id18}
  connect(brake, abs.brake) {^id19}
  connect(slip_fl, tc.slip_fl) {^id20}
  connect(slip_fr, tc.slip_fr) {^id21}
  connect(slip_rl, tc.slip_rl) {^id22}
  connect(slip_rr, tc.slip_rr) {^id23}
  connect(slip_fl, abs.slip_fl) {^id24}
  connect(slip_fr, abs.slip_fr) {^id25}
  connect(slip_rl, abs.slip_rl) {^id26}
  connect(slip_rr, abs.slip_rr) {^id27}
  connect(abs.brake_demand, brake_demand) {^id28}

