component VehicleControl
  "Traction control with a shared drive power limit, and anti-lock brake control."

  inputs = VehicleControlInputs() {^inputs}
  outputs = VehicleControlOutputs() {^outputs}

  tc = VehicleComponents.TorqueControlLaunch() {^tc}
  abs = VehicleComponents.ABSControl() {^abs}

  parameter total_max_power::Power
  variable requested_power::Power
  variable power_scale::Real

relations

  # Inputs
  tc.inputs.throttle = inputs.throttle
  abs.inputs.brake = inputs.brake
  tc.inputs.slip_fl = inputs.slip_fl
  tc.inputs.slip_fr = inputs.slip_fr
  tc.inputs.slip_rl = inputs.slip_rl
  tc.inputs.slip_rr = inputs.slip_rr
  abs.inputs.slip_fl = inputs.slip_fl
  abs.inputs.slip_fr = inputs.slip_fr
  abs.inputs.slip_rl = inputs.slip_rl
  abs.inputs.slip_rr = inputs.slip_rr

  # Outputs
  outputs.power_scale = power_scale
  outputs.abs_intervention = abs.outputs.intervention
  outputs.demand_fl = tc.outputs.demand_fl * power_scale
  outputs.demand_fr = tc.outputs.demand_fr * power_scale
  outputs.demand_rl = tc.outputs.demand_rl * power_scale
  outputs.demand_rr = tc.outputs.demand_rr * power_scale
  outputs.brake_demand = abs.outputs.brake_demand

  # Equations
  requested_power = tc.outputs.demand_fl * inputs.full_demand_power_fl + tc.outputs.demand_fr * inputs.full_demand_power_fr +
                    tc.outputs.demand_rl * inputs.full_demand_power_rl + tc.outputs.demand_rr * inputs.full_demand_power_rr
  power_scale = ifelse(requested_power > total_max_power, total_max_power / requested_power, 1)

metadata {
  "Dyad": {
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0
      }
    ],
    "panel": {
      "control": "tabs",
      "children": {
        "Power limit": {
          "contents": [
            "total_max_power"
          ]
        }
      }
    }
  },
  "_links": {
    "tc": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 450,
            "x2": 550,
            "y1": 320,
            "y2": 420
          }
        }
      }
    },
    "abs": {
