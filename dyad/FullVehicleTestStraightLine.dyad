test component FullVehicleTestStraightLine
  """
  Straight line acceleration test

  The sprung mass is connected to the world by a 6 joint stack, with yaw locked
  at zero so the car can only travel straight.
  """

  extends Styles

  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}

  throttle = BlockComponents.Sources.Step(
    height = 1.0,
    offset = 0.0,
    start_time = drive_start_time
  ) {^throttle}

  longitudinal_joint = MultibodyComponents.Prismatic(n = [1, 0, 0], render = false) {^longitudinal_joint}
  lateral_joint = MultibodyComponents.Prismatic(n = [0, 1, 0], render = false) {^lateral_joint}
  heave_joint = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^heave_joint}
  roll_joint = MultibodyComponents.Revolute(n = [1, 0, 0], render = false) {^roll_joint}
  pitch_joint = MultibodyComponents.Revolute(n = [0, 1, 0], render = false) {^pitch_joint}
  yaw_joint = MultibodyComponents.Revolute(n = [0, 0, 1], render = false) {^yaw_joint}
  yaw_lock = RotationalComponents.Components.Fixed(phi0 = 0.0) {^yaw_lock}

  vehicle = VehicleComponents.FullVehicle(
    sprung_mass = 250.0,
    sprung_cg = [-0.7, 0, 0.2835],
    sprung_I_11 = 30.0,
    sprung_I_22 = 80.0,
