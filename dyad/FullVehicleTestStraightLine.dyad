test component FullVehicleTestStraightLine
  """
  Straight line acceleration test
  
  The sprung mass is connected to the world by a 6 joint stack, with yaw locked
  at zero so the car can only travel straight.
  """

  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}

  throttle_on = BlockComponents.Sources.Step(
    height = 1.0,
    offset = 0.0,
    start_time = drive_start_time
  ) {^throttle_on}
  throttle_off = BlockComponents.Sources.Step(
    height = -1.0,
    offset = 0.0,
    start_time = drive_start_time + drive_duration
  ) {^throttle_off}
  throttle = BlockComponents.Math.Add() {^throttle}
  brake = BlockComponents.Sources.Step(
    height = brake_level,
    offset = 0.0,
    start_time = brake_start_time
  ) {^brake}
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}

  longitudinal_joint = MultibodyComponents.Prismatic(n = [1, 0, 0], render = false) {^longitudinal_joint}
  lateral_joint = MultibodyComponents.Prismatic(n = [0, 1, 0], render = false) {^lateral_joint}
  heave_joint = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^heave_joint}
  roll_joint = MultibodyComponents.Revolute(n = [1, 0, 0], render = false) {^roll_joint}
  pitch_joint = MultibodyComponents.Revolute(n = [0, 1, 0], render = false) {^pitch_joint}
  yaw_joint = MultibodyComponents.Revolute(n = [0, 0, 1], render = false) {^yaw_joint}
  yaw_lock = RotationalComponents.Components.Fixed(phi0 = 0.0) {^yaw_lock}
  
  vehicle = VehicleComponents.FullVehicle() {^vehicle}

  track = VehicleComponents.StraightLineTrack() {^track}

  parameter drive_start_time::Time = 1.5
  parameter drive_duration::Time = 1.5
  parameter brake_level::Real = 0.0
  parameter brake_start_time::Time = 1.5

relations

  initial longitudinal_joint.s = 0.0
  initial longitudinal_joint.v = 0.0
  initial lateral_joint.s = 0.0
  initial lateral_joint.v = 0.0
  initial heave_joint.s = 0.0
  initial heave_joint.v = 0.0
  initial roll_joint.phi = 0.0
  initial roll_joint.w = 0.0
  initial pitch_joint.phi = 0.0
  initial pitch_joint.w = 0.0
  initial vehicle.front_suspension.linkage_left.lca_rev.phi = 0.0
  initial vehicle.front_suspension.linkage_left.lca_rev.w = 0.0
  initial vehicle.front_suspension.linkage_right.lca_rev.phi = 0.0
  initial vehicle.front_suspension.linkage_right.lca_rev.w = 0.0
  initial vehicle.rear_suspension.linkage_left.lca_rev.phi = 0.0
  initial vehicle.rear_suspension.linkage_left.lca_rev.w = 0.0
  initial vehicle.rear_suspension.linkage_right.lca_rev.phi = 0.0
  initial vehicle.rear_suspension.linkage_right.lca_rev.w = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.w = 0.0
  initial vehicle.front_suspension.steering_rack.rack_drive.v = 0.0
  initial vehicle.rear_suspension.steering_rack.rack_drive.v = 0.0

  connect(throttle_on.y, throttle.u1) {^id19}
  connect(throttle_off.y, throttle.u2) {^id20}
  connect(throttle.y, vehicle.throttle) {^id21}
  connect(brake.y, vehicle.brake) {^id22}
  connect(steer.y, vehicle.steer) {^id23}
  connect(world.frame_b, lateral_joint.frame_a) {^id24}
  connect(lateral_joint.frame_b, longitudinal_joint.frame_a) {^id25}
  connect(longitudinal_joint.frame_b, heave_joint.frame_a) {^id26}
  connect(heave_joint.frame_b, roll_joint.frame_a) {^id27}
  connect(roll_joint.frame_b, pitch_joint.frame_a) {^id28}
  connect(pitch_joint.frame_b, yaw_joint.frame_a) {^id29}
  connect(yaw_joint.axis, yaw_lock.spline) {^id30}
  connect(yaw_joint.frame_b, vehicle.rig) {^id31}

