  ) {^vehicle}

  parameter drive_torque::Torque = 5.0
  parameter drive_start_time::Time = 1.5

  relations

  initial longitudinal_joint.s = 0.0
  initial longitudinal_joint.v = 0.0
  initial lateral_joint.s = 0.0
  initial lateral_joint.v = 0.0
  initial heave_joint.s = 0.0
  initial heave_joint.v = 0.0
  initial roll_joint.phi = 0.0
  initial roll_joint.w = 0.0
  initial pitch_joint.phi = 0.0
  initial pitch_joint.w = 0.0
  initial yaw_joint.phi = 0.0
  initial yaw_joint.w = 0.0
  initial vehicle.front_suspension.linkage_left.lca_rev.phi = 0.0
  initial vehicle.front_suspension.linkage_left.lca_rev.w = 0.0
  initial vehicle.front_suspension.linkage_right.lca_rev.phi = 0.0
  initial vehicle.front_suspension.linkage_right.lca_rev.w = 0.0
  initial vehicle.rear_suspension.linkage_left.lca_rev.phi = 0.0
  initial vehicle.rear_suspension.linkage_left.lca_rev.w = 0.0
  initial vehicle.rear_suspension.linkage_right.lca_rev.phi = 0.0
  initial vehicle.rear_suspension.linkage_right.lca_rev.w = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.w = 0.0

  vehicle.corner_fl.motor.tau = ifelse(time < drive_start_time, 0, drive_torque)
  vehicle.corner_fr.motor.tau = ifelse(time < drive_start_time, 0, drive_torque)
  vehicle.corner_rl.motor.tau = ifelse(time < drive_start_time, 0, drive_torque)
  vehicle.corner_rr.motor.tau = ifelse(time < drive_start_time, 0, drive_torque)

  connect(world.frame_b, lateral_joint.frame_a) {^id11}
  connect(lateral_joint.frame_b, longitudinal_joint.frame_a) {^id12}
  connect(longitudinal_joint.frame_b, heave_joint.frame_a) {^id13}
  connect(heave_joint.frame_b, roll_joint.frame_a) {^id9}
  connect(roll_joint.frame_b, pitch_joint.frame_a) {^id10}
  connect(pitch_joint.frame_b, yaw_joint.frame_a) {^id14}
  connect(yaw_joint.frame_b, vehicle.rig) {^id15}

