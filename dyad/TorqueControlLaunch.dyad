component TorqueControlLaunch
  """Launch torque control: independent per-corner slip regulation."""

  extends TorqueControl

  control_fl = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_front,
    final launch_torque = launch_torque,
    final motor_torque_max = motor_torque_max,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_fl}
  control_fr = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_front,
    final launch_torque = launch_torque,
    final motor_torque_max = motor_torque_max,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_fr}
  control_rl = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_rear,
    final launch_torque = launch_torque,
    final motor_torque_max = motor_torque_max,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_rl}
  control_rr = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_rear,
    final launch_torque = launch_torque,
    final motor_torque_max = motor_torque_max,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_rr}

  parameter slip_target_front::Real
  parameter slip_target_rear::Real
  parameter launch_torque::Real
  parameter motor_torque_max::Real
  parameter k::Real
  parameter Ti::Time
  parameter Ni::Real

relations

  connect(throttle, control_fl.throttle, control_fr.throttle, control_rl.throttle, control_rr.throttle) {^id5}
  connect(slip_fl, control_fl.slip) {^id6}
  connect(slip_fr, control_fr.slip) {^id7}
  connect(slip_rl, control_rl.slip) {^id8}
  connect(slip_rr, control_rr.slip) {^id9}
  connect(control_fl.tau, tau_fl) {^id10}
  connect(control_fr.tau, tau_fr) {^id11}
  connect(control_rl.tau, tau_rl) {^id12}
  connect(control_rr.tau, tau_rr) {^id13}

