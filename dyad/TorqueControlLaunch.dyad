component TorqueControlLaunch
  """Launch torque control: independent per-corner slip regulation."""

  extends TorqueControl

  control_fl = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_front,
    final launch_torque = launch_torque,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_fl}
  control_fr = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_front,
    final launch_torque = launch_torque,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_fr}
  control_rl = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_rear,
    final launch_torque = launch_torque,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_rl}
  control_rr = VehicleComponents.TorqueControlTC(
    final slip_target = slip_target_rear,
    final launch_torque = launch_torque,
    final k = k,
    final Ti = Ti,
    final Ni = Ni
  ) {^control_rr}

  parameter slip_target_front::Real
  parameter slip_target_rear::Real
  parameter launch_torque::Real
  parameter k::Real
  parameter Ti::Time
  parameter Ni::Real

relations

  # Inputs
  control_fl.inputs.throttle = inputs.throttle
  control_fr.inputs.throttle = inputs.throttle
  control_rl.inputs.throttle = inputs.throttle
  control_rr.inputs.throttle = inputs.throttle
  control_fl.inputs.slip = inputs.slip_fl
  control_fr.inputs.slip = inputs.slip_fr
  control_rl.inputs.slip = inputs.slip_rl
  control_rr.inputs.slip = inputs.slip_rr

  # Outputs
  outputs.demand_fl = control_fl.outputs.demand
  outputs.demand_fr = control_fr.outputs.demand
  outputs.demand_rl = control_rl.outputs.demand
  outputs.demand_rr = control_rr.outputs.demand

metadata {
  "Dyad": {
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0
      },
      {
        "label": "F $(slip_target_front) / R $(slip_target_rear)",
        "x": 500,
        "y": 800,
        "rot": 0
      }
    ],
    "panel": {
      "control": "tabs",
      "children": {
        "Traction": {
          "contents": [
            "slip_target_front",
            "slip_target_rear",
            "launch_torque"
          ]
        },
        "Controller": {
          "contents": [
            "k",
            "Ti",
            "Ni"
          ]
        }
      }
    }
  },
  "_links": {
    "control_fl": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 450,
            "x2": 550,
