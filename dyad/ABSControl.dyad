component ABSControl
  """
  Global ABS brake-pressure reduction from the most negative wheel slip.

  `intervention` is the applied brake-release fraction: zero leaves the driver
  request unchanged and one releases all requested brake pressure.
  """

  inputs = ABSControlInputs() {^inputs}
  outputs = ABSControlOutputs() {^outputs}

  parameter slip_target::Real
  parameter k::Real

  variable excess_fl::Real
  variable excess_fr::Real
  variable excess_rl::Real
  variable excess_rr::Real
  variable max_excess::Real
  variable p_action::Real
  variable brake_scale::Real

relations

  # Outputs
  outputs.intervention = 1 - brake_scale
  outputs.brake_demand = inputs.brake * brake_scale

  # Equations
  excess_fl = max(0, -inputs.slip_fl - slip_target)
  excess_fr = max(0, -inputs.slip_fr - slip_target)
  excess_rl = max(0, -inputs.slip_rl - slip_target)
  excess_rr = max(0, -inputs.slip_rr - slip_target)
  max_excess = max(max(excess_fl, excess_fr), max(excess_rl, excess_rr))
  p_action = k * max_excess
  brake_scale = max(0, 1 - p_action)

metadata {
  "Dyad": {
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0
      },
      {
        "label": "slip = -$(slip_target)",
        "x": 500,
        "y": 800,
        "rot": 0
      }
    ],
    "panel": {
      "control": "tabs",
      "children": {
        "Braking control": {
          "contents": [
            "slip_target",
            "k"
          ]
        }
      }
    }
  },
  "_links": {
    "inputs": {
      "Dyad": {
        "placement": {
          "icon": {
            "x1": -50.0,
            "y1": 100.0,
            "x2": 50.0,
            "y2": 200.0
          },
          "diagram": {
            "x1": -50,
            "x2": 50,
            "y1": 20,
            "y2": 120
          }
        }
      }
    },
    "outputs": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 950,
            "x2": 1050,
            "y1": 20,
            "y2": 120
          },
          "icon": {
            "x1": 950.0,
            "y1": 100.0,
            "x2": 1050.0,
            "y2": 200.0
          }
        }
      }
    }
  }
}
end
