component CornerAssembly
  """
  Everything at one corner except the suspension links: upright, hub motor,
  brake and wheel assembly.
  
  This component owns the non-rotating unsprung mass (the upright and the
  motor). Rim and tire mass/inertia live in the WheelAssembly.
  
  Motor torque goes into the wheel and its reaction onto the wheel centre,
  which is the same node as the upright. Upright and motor share a node and
  a CoG, so they merge into one body. The brake acts on the same spline, in
  the opposite.
  """

  motor_torque = RealInput(units = "N.m") {^motor_torque}
  brake_demand = RealInput(units = "1") {^brake_demand}

  slip = RealOutput() {^slip}

  wheel_center = Dyad.Frame3D() {^wheel_center}
  wheel_assembly = VehicleComponents.WheelAssembly(is_left = is_left) {^wheel_assembly}
  motor = VehicleComponents.HubMotor() {^motor}
  brake = VehicleComponents.Brake(
    is_front = is_front
  ) {^brake}
  upright = MultibodyComponents.Body(
    m = upright_mass,
    r_cm = [0, 0, 0],
    I_11 = upright_I_11,
    I_22 = upright_I_22,
    I_33 = upright_I_33,
    cylinder_radius = 0
  ) {^upright}

  structural parameter is_left::Boolean
  structural parameter is_front::Boolean

  parameter upright_mass::Mass
  parameter upright_I_11::Inertia
  parameter upright_I_22::Inertia
  parameter upright_I_33::Inertia

relations

  connect(wheel_center, wheel_assembly.wheel_center) {^id9}
  connect(wheel_center, upright.frame_a) {^id10}
  connect(motor.wheel_center, wheel_center) {^id11}
  connect(wheel_assembly.spline, motor.spline) {^id12}
  connect(motor_torque, motor.tau) {^id13}
  connect(wheel_assembly.slip, slip) {^id14}
  connect(wheel_assembly.spline, brake.spline) {^id15}
  connect(brake_demand, brake.brake_demand) {^id16}
  connect(brake.wheel_center, wheel_center) {^id17}

