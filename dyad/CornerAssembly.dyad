component CornerAssembly
  """
  Everything at one corner except the suspension links: upright, hub motor,
  brake and wheel assembly.
  
  This component owns the non-rotating unsprung mass (the upright and the
  motor). Rim and tire mass/inertia live in the WheelAssembly.
  
  Motor torque goes into the wheel and its reaction onto the wheel centre,
  which is the same node as the upright. Upright and motor share a node and
  a CoG, so they merge into one body. The brake acts on the same spline, in
  the opposite.
  """

  inputs = CornerAssemblyInputs() {^inputs}
  outputs = CornerAssemblyOutputs() {^outputs}

  wheel_center = Dyad.Frame3D() {^wheel_center}
  wheel_assembly = VehicleComponents.WheelAssembly() {^wheel_assembly}
  motor = VehicleComponents.HubMotor() {^motor}
  brake = VehicleComponents.Brake() {^brake}
  upright = MultibodyComponents.Body(
    m = upright_mass,
    r_cm = [0, 0, 0],
    I_11 = 0,
    I_22 = 0,
    I_33 = 0,
    cylinder_radius = 0
  ) {^upright}

  parameter upright_mass::Mass

relations

  # Inputs
  motor.inputs.demand = inputs.motor_demand
  brake.inputs.brake_demand = inputs.brake_demand

  # Outputs
  outputs.Fx = wheel_assembly.outputs.Fx
  outputs.Fy = wheel_assembly.outputs.Fy
  outputs.Fz = wheel_assembly.outputs.Fz
  outputs.alpha = wheel_assembly.outputs.alpha
  outputs.omega = wheel_assembly.outputs.omega
  outputs.Re = wheel_assembly.outputs.Re
  outputs.slip = wheel_assembly.outputs.slip
  outputs.tau_motor = motor.outputs.tau_motor
  outputs.tau_wheel = motor.outputs.tau_wheel
  outputs.power = motor.outputs.power
  outputs.full_demand_power = motor.outputs.full_demand_power
  outputs.tau_brake = brake.outputs.tau_brake

  # Connections
  connect(wheel_center, wheel_assembly.wheel_center) {^id10}
  connect(wheel_center, upright.frame_a) {^id11}
  connect(motor.wheel_center, wheel_center) {^id12}
  connect(wheel_assembly.spline, motor.spline) {^id13}
  connect(wheel_assembly.spline, brake.spline) {^id17}
  connect(brake.wheel_center, wheel_center) {^id19}

