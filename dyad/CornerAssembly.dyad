component CornerAssembly
  """
  Everything at one corner except the suspension links: upright, hub motor
  and wheel assembly.

  This component owns the non-rotating unsprung mass (the upright and the
  motor). Rim and tire mass/inertia live in the WheelAssembly.

  Motor torque goes into the wheel and its reaction onto the wheel centre,
  which is the same node as the upright.
  """

  wheel_center = Dyad.Frame3D() {^wheel_center}

  wheel_assembly = VehicleComponents.WheelAssembly() {^wheel_assembly}

  motor = VehicleComponents.HubMotor(
    axis = spin_axis,
    gear_ratio = drive_gear_ratio
  ) {^motor}

  # Upright and motor share a node and a CoG, so they merge into one
  # body with no parallel-axis terms.
  upright = MultibodyComponents.Body(
    m = upright_mass,
    r_cm = [0, 0, 0],
    I_11 = upright_I_11,
    I_22 = upright_I_22,
    I_33 = upright_I_33,
    cylinder_radius = 0
  ) {^upright}

  parameter spin_axis::Real[3] = [0, 1, 0]
  parameter drive_gear_ratio::Real = 1.0

  # Non-rotating unsprung: upright and motor stator
  parameter upright_mass::Mass
  parameter upright_I_11::Inertia
  parameter upright_I_22::Inertia
  parameter upright_I_33::Inertia

relations

  connect(wheel_center, wheel_assembly.wheel_center) {^id5}
  connect(wheel_center, upright.frame_a) {^id6}
  connect(motor.wheel_center, wheel_center) {^id7}
  connect(wheel_assembly.spline, motor.spline) {^id8}

metadata {
