component TorqueControlTC
  """Per-corner slip control"""

  slip = RealInput() {^slip}
  throttle = RealInput() {^throttle}

  demand = RealOutput(units = "1") {^demand}

  slip_ref = BlockComponents.Math.Gain(final k = slip_target) {^slip_ref}
  torque_ff = BlockComponents.Math.Gain(final k = launch_torque) {^torque_ff}
  pid = BlockComponents.Continuous.LimPID(
    final with_D = false,
    final k = k,
    final Ti = Ti,
    final Ni = Ni,
    final wp = wp,
    final y_max = 1,
    final y_min = 0,
    final k_ff = 1
  ) {^pid}
  gate = BlockComponents.Math.Product() {^gate}

  parameter slip_target::Real
  parameter launch_torque::Real
  parameter k::Real
  parameter Ti::Time
  parameter Ni::Real

  final parameter wp::Real = 0

relations

  connect(throttle, slip_ref.u, torque_ff.u, gate.u2) {^id8}
  connect(slip_ref.y, pid.u_s) {^id9}
  connect(torque_ff.y, pid.u_ff) {^id10}
  connect(slip, pid.u_m) {^id11}
  connect(pid.y, gate.u1) {^id12}
  connect(gate.y, demand) {^id13}

metadata {
  "Dyad": {
    "labels": [
      {"label": "$(instance)", "x": 500, "y": 1100, "rot": 0},
      {"label": "slip = $(slip_target)", "x": 500, "y": 800, "rot": 0}
    ]
  },
  "_links": {
