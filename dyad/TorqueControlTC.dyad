component TorqueControlTC
  """Per-corner slip control"""

  inputs = TorqueControlTCInputs() {^inputs}
  outputs = TorqueControlTCOutputs() {^outputs}

  slip_ref = BlockComponents.Math.Gain(final k = slip_target) {^slip_ref}
  torque_ff = BlockComponents.Math.Gain(final k = launch_torque) {^torque_ff}
  pid = BlockComponents.Continuous.LimPID(
    final with_D = false,
    final k = k,
    final Ti = Ti,
    final Ni = Ni,
    final wp = wp,
    final y_max = 1,
    final y_min = 0,
    final k_ff = 1
  ) {^pid}
  gate = BlockComponents.Math.Product() {^gate}

  parameter slip_target::Real
  parameter launch_torque::Real
  parameter k::Real
  parameter Ti::Time
  parameter Ni::Real

  final parameter wp::Real = 0

relations

  # Inputs
  slip_ref.u = inputs.throttle
  torque_ff.u = inputs.throttle
  gate.u2 = inputs.throttle
  pid.u_m = inputs.slip

  # Outputs
  outputs.demand = gate.y

  # Connections
  connect(slip_ref.y, pid.u_s) {^id9}
  connect(torque_ff.y, pid.u_ff) {^id10}
  connect(pid.y, gate.u1) {^id12}

metadata {
