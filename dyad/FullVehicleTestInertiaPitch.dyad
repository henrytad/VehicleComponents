test component FullVehicleTestInertiaPitch
  """
  Inverted pendulum method for determining pitch inertia.
  """
  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}
  mount = MultibodyComponents.FixedTranslation(r = pivot + [0, 0, ground_clearance], render = false) {^mount}
  pitch_joint = MultibodyComponents.Revolute(n = [0, 1, 0], n_nonzero = [false, true, false], render = false) {^pitch_joint}
  rig_offset = MultibodyComponents.FixedTranslation(r = -pivot, render = false) {^rig_offset}
  lock_fl = RotationalComponents.Components.Fixed() {^lock_fl}
  lock_fr = RotationalComponents.Components.Fixed() {^lock_fr}
  lock_rl = RotationalComponents.Components.Fixed() {^lock_rl}
  lock_rr = RotationalComponents.Components.Fixed() {^lock_rr}

  throttle = BlockComponents.Sources.Constant(k = 0.0) {^throttle}
  brake = BlockComponents.Sources.Constant(k = 0.0) {^brake}
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}
  vehicle = VehicleComponents.InertiaFixtureVehicle(
    apply "dyad://VehicleComponents/TestVehicle.toml",
    aero(CdA = 0.0, ClA = 0.0)
  ) {^vehicle}

  parameter reference_cg::Position[3] = [-0.7, 0.0, 0.2835]
  parameter pivot_height::Length = 0.5
  parameter ground_clearance::Length = 0.3
  parameter initial_pitch::Angle = 0.035

  final parameter pivot::Position[3] = reference_cg + [0, 0, pivot_height]

relations

  # Inputs
  vehicle.inputs.throttle = throttle.y
  vehicle.inputs.brake = brake.y
  vehicle.inputs.steer = steer.y

  # Initialization
  initial pitch_joint.phi = initial_pitch
  initial pitch_joint.w = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.w = 0.0
  initial vehicle.front_suspension.steering_rack.rack_drive.v = 0.0
  initial vehicle.rear_suspension.steering_rack.rack_drive.v = 0.0

  # Connections
  connect(world.frame_b, mount.frame_a) {^id16}
  connect(mount.frame_b, pitch_joint.frame_a) {^id17}
  connect(pitch_joint.frame_b, rig_offset.frame_a) {^id18}
  connect(rig_offset.frame_b, vehicle.rig) {^id19}
  connect(lock_fl.spline, vehicle.restraint_fl) {^id20}
  connect(lock_fr.spline, vehicle.restraint_fr) {^id21}
  connect(lock_rl.spline, vehicle.restraint_rl) {^id22}
  connect(lock_rr.spline, vehicle.restraint_rr) {^id23}

metadata {
  "Dyad": {
    "tests": {
      "pitch_release": {
        "stop": 1.0,
        "solver": "Rodas5P",
        "expect": {
          "signals": [
            "pitch_joint.phi",
            "pitch_joint.w"
          ]
        }
      }
    }
  },
  "_links": {
