component Damper
  """
  Nonlinear damper: force looked up from a force-velocity map.
  """

  extends MultibodyComponents.PartialLineForce

  outputs = DamperOutputs() {^outputs}

  structural parameter dataset::DyadData.DyadTimeseries

  force_map = BlockComponents.Tables.ParameterizedInterpolation(
    interpolation_type = BlockComponents.InterpolationType.LinearInterpolation(),
    extrapolation_type = BlockComponents.ExtrapolationType.Linear(),
    dataset = dataset
  )

  "Strut velocity seen by the damper, negative in compression"
  variable v::Velocity

relations

  # Outputs
  outputs.s = s
  outputs.f = f
  outputs.v = v

  # Equations
  force_map.u = v
  v = der(s)
  f = force_map.y

metadata {
  "_links": {
    "outputs": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 950.0,
            "y1": 20.0,
            "x2": 1050.0,
            "y2": 120.0
          },
          "icon": {
            "x1": 950.0,
            "y1": 100.0,
            "x2": 1050.0,
            "y2": 200.0
          }
        }
      }
    }
  },
  "Dyad": {
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "layer": "icon"
      }
    ]
  }
}
end
