      }
    },
    "id14": {"Dyad": {"edges": [{"S": 1, "M": [], "E": 2}], "path": {}}},
    "id15": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 240, "y": 180}], "E": 2}], "path": {}}},
    "id16": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 790, "y": 180}], "E": 2}], "path": {}}},
    "id17": {"Dyad": {"edges": [{"S": 1, "M": [{"x": 500, "y": 60}], "E": 2}], "path": {}}}
  }
}
end
