component FullVehicle
  """
  Full vehicle
 
  The `rig` frame is the sprung mass reference. Attach it to ground through
  whatever DOF the study needs.
  """

  rig = Dyad.Frame3D() {^rig}
  
  # Sprung mass
  body = MultibodyComponents.Body(
    m = sprung_mass,
    r_cm = cg_offset,
    I_11 = sprung_I_11,
    I_22 = sprung_I_22,
    I_33 = sprung_I_33,
    cylinder_radius = 0
  ) {^body}

  # Tires
  tire_fr = VehicleComponents.TireMF61() {^tire_fr}
  tire_fl = VehicleComponents.TireMF61() {^tire_fl}
  tire_rl = VehicleComponents.TireMF61() {^tire_rl}
  tire_rr = VehicleComponents.TireMF61() {^tire_rr}

  # Axles
  front_suspension = VehicleComponents.Suspension() {^front_suspension}
  rear_suspension = VehicleComponents.Suspension() {^rear_suspension}

  # Sprung mass properties
  parameter sprung_mass::Mass
  parameter sprung_I_11::Inertia
  parameter sprung_I_22::Inertia
  parameter sprung_I_33::Inertia
  parameter cg_offset::Position[3]

relations

  # Sprung mass
  connect(body.frame_a, rig) {^id15}
  connect(front_suspension.chassis, body.frame_a) {^id13}
  connect(rear_suspension.chassis, body.frame_a) {^id14}
 
  # Front corners
  connect(front_suspension.wheel_left, tire_fl.wheel_center) {^id9}
  connect(front_suspension.wheel_right, tire_fr.wheel_center) {^id10}
 
  # Rear corners
  connect(rear_suspension.wheel_left, tire_rl.wheel_center) {^id11}
  connect(rear_suspension.wheel_right, tire_rr.wheel_center) {^id12}

