component FullVehicle
  """
  Full vehicle

  The `rig` frame is the sprung mass reference. Attach it to ground through
  whatever DOF the study needs.

  The vehicle takes a single `throttle` request and `control` decides what each 
  hub motor gets.
  """

  throttle = RealInput() {^throttle}

  rig = Dyad.Frame3D() {^rig}
  body = MultibodyComponents.Body(
    m = sprung_mass,
    r_cm = sprung_cg,
    I_11 = sprung_I_11,
    I_22 = sprung_I_22,
    I_33 = sprung_I_33,
    cylinder_radius = 0
  ) {^body}
  corner_fl = VehicleComponents.CornerAssembly() {^corner_fl}
  corner_fr = VehicleComponents.CornerAssembly() {^corner_fr}
  corner_rl = VehicleComponents.CornerAssembly() {^corner_rl}
  corner_rr = VehicleComponents.CornerAssembly() {^corner_rr}
  front_suspension = VehicleComponents.Suspension() {^front_suspension}
  rear_suspension = VehicleComponents.Suspension() {^rear_suspension}
  control = VehicleComponents.TorqueControlLaunch() {^control}

  # Sprung mass properties
  parameter sprung_mass::Mass
  parameter sprung_I_11::Inertia
  parameter sprung_I_22::Inertia
  parameter sprung_I_33::Inertia
  parameter sprung_cg::Position[3]

relations

  # Sprung mass
  connect(body.frame_a, rig) {^id11}
  connect(front_suspension.chassis, body.frame_a) {^id12}
  connect(rear_suspension.chassis, body.frame_a) {^id13}

  # Corners to suspension
  connect(front_suspension.wheel_left, corner_fl.wheel_center) {^id14}
  connect(front_suspension.wheel_right, corner_fr.wheel_center) {^id15}
  connect(rear_suspension.wheel_left, corner_rl.wheel_center) {^id16}
  connect(rear_suspension.wheel_right, corner_rr.wheel_center) {^id17}

  # Torque control
  connect(corner_fl.slip, control.slip_fl) {^id18}
  connect(corner_fr.slip, control.slip_fr) {^id19}
  connect(corner_rl.slip, control.slip_rl) {^id20}
  connect(corner_rr.slip, control.slip_rr) {^id21}
  connect(control.tau_fl, corner_fl.tau_cmd) {^id22}
  connect(control.tau_fr, corner_fr.tau_cmd) {^id23}
  connect(control.tau_rl, corner_rl.tau_cmd) {^id24}
  connect(control.tau_rr, corner_rr.tau_cmd) {^id25}
  connect(throttle, control.throttle) {^id26}

