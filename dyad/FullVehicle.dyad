component FullVehicle
  """
  Full vehicle
  
  The `rig` frame is the sprung mass reference. Attach it to ground through
  whatever DOF the study needs.
  
  The vehicle takes a single `throttle` request and `control` decides what each 
  hub motor gets.
  """

  inputs = FullVehicleInputs() {^inputs}
  outputs = FullVehicleOutputs() {^outputs}

  rig = Dyad.Frame3D() {^rig}
  body = MultibodyComponents.Body(
    m = sprung_mass,
    r_cm = sprung_cg,
    I_11 = sprung_I_11,
    I_22 = sprung_I_22,
    I_33 = sprung_I_33,
    cylinder_radius = 0
  ) {^body}
  corner_fl = VehicleComponents.CornerAssembly(
    wheel_assembly(
      tire(
        is_left = true,
        road(
          N = road_N,
          seed = road_seed,
          n_min = road_n_min,
          n_max = road_n_max
        )
      )
    ),
    brake(
      is_front = true,
      brake_bias = brake_bias,
      max_torque = max_brake_torque
    )
  ) {^corner_fl}
  corner_fr = VehicleComponents.CornerAssembly(
    wheel_assembly(
      tire(
        is_left = false,
        road(
          N = road_N,
          seed = road_seed,
          n_min = road_n_min,
          n_max = road_n_max
        )
      )
    ),
    brake(
      is_front = true,
      brake_bias = brake_bias,
      max_torque = max_brake_torque
    )
  ) {^corner_fr}
  corner_rl = VehicleComponents.CornerAssembly(
    wheel_assembly(
      tire(
        is_left = true,
        road(
          N = road_N,
          seed = road_seed,
          n_min = road_n_min,
          n_max = road_n_max
        )
      )
    ),
    brake(
      is_front = false,
      brake_bias = brake_bias,
      max_torque = max_brake_torque
    )
  ) {^corner_rl}
  corner_rr = VehicleComponents.CornerAssembly(
    wheel_assembly(
      tire(
        is_left = false,
        road(
          N = road_N,
          seed = road_seed,
          n_min = road_n_min,
          n_max = road_n_max
        )
      )
    ),
    brake(
      is_front = false,
      brake_bias = brake_bias,
      max_torque = max_brake_torque
    )
  ) {^corner_rr}
  front_suspension = VehicleComponents.Suspension(
    heave_dataset = VehicleComponents.damper_dataset(
      heave_damper_compression_front,
      heave_damper_extension_front
    ),
    roll_dataset = VehicleComponents.damper_dataset(
      roll_damper_compression_front,
      roll_damper_extension_front
    )
  ) {^front_suspension}
  rear_suspension = VehicleComponents.Suspension(
    heave_dataset = VehicleComponents.damper_dataset(
      heave_damper_compression_rear,
      heave_damper_extension_rear
    ),
    roll_dataset = VehicleComponents.damper_dataset(
      roll_damper_compression_rear,
      roll_damper_extension_rear
    )
  ) {^rear_suspension}
  control = VehicleComponents.VehicleControl() {^control}
  aero = VehicleComponents.AeroLoad() {^aero}
  body_angles = MultibodyComponents.AbsoluteAngles(sequence = [3, 2, 1]) {^body_angles}

  structural parameter heave_damper_compression_front::String
  structural parameter heave_damper_extension_front::String
  structural parameter roll_damper_compression_front::String
  structural parameter roll_damper_extension_front::String
  structural parameter heave_damper_compression_rear::String
  structural parameter heave_damper_extension_rear::String
  structural parameter roll_damper_compression_rear::String
  structural parameter roll_damper_extension_rear::String
  structural parameter road_N::Integer
  structural parameter road_seed::Integer
  structural parameter road_n_min::Real
  structural parameter road_n_max::Real

  parameter vehicle_name::String
  parameter brake_bias::Real
  parameter max_brake_torque::Torque
  parameter sprung_mass::Mass
  parameter sprung_I_11::Inertia
  parameter sprung_I_22::Inertia
  parameter sprung_I_33::Inertia
  parameter sprung_cg::Position[3]

  variable w_cg::Angle[3]
  variable a_cg::Acceleration[3]
  variable v_cg::Velocity[3]

relations

  # Inputs
  control.inputs.slip_fl = corner_fl.outputs.slip
  control.inputs.slip_fr = corner_fr.outputs.slip
  control.inputs.slip_rl = corner_rl.outputs.slip
  control.inputs.slip_rr = corner_rr.outputs.slip
  control.inputs.full_demand_power_fl = corner_fl.outputs.full_demand_power
  control.inputs.full_demand_power_fr = corner_fr.outputs.full_demand_power
  control.inputs.full_demand_power_rl = corner_rl.outputs.full_demand_power
  control.inputs.full_demand_power_rr = corner_rr.outputs.full_demand_power
  corner_fl.inputs.motor_demand = control.outputs.demand_fl
  corner_fr.inputs.motor_demand = control.outputs.demand_fr
  corner_rl.inputs.motor_demand = control.outputs.demand_rl
  corner_rr.inputs.motor_demand = control.outputs.demand_rr
  control.inputs.throttle = inputs.throttle
  control.inputs.brake = inputs.brake
  corner_fl.inputs.brake_demand = control.outputs.brake_demand
  corner_fr.inputs.brake_demand = control.outputs.brake_demand
  corner_rl.inputs.brake_demand = control.outputs.brake_demand
  corner_rr.inputs.brake_demand = control.outputs.brake_demand
  rear_suspension.inputs.steer = 0
  front_suspension.inputs.steer = inputs.steer

  # Outputs
  outputs.body.w_cg = w_cg
  outputs.body.a_cg = a_cg
  outputs.body.v_cg = v_cg
  outputs.body.position = body.r_0 + MultibodyComponents.resolve1(body.frame_a.R, sprung_cg)
  connect(outputs.corner_fl, corner_fl.outputs) {^id14}
  connect(outputs.corner_fr, corner_fr.outputs) {^id15}
  connect(outputs.corner_rl, corner_rl.outputs) {^id16}
  connect(outputs.corner_rr, corner_rr.outputs) {^id17}
  connect(outputs.front_suspension, front_suspension.outputs) {^id18}
  connect(outputs.rear_suspension, rear_suspension.outputs) {^id19}
  connect(outputs.aero, aero.outputs) {^id20}
  connect(outputs.control, control.outputs) {^id21}

  # Equations
  w_cg = body_angles.angles
  a_cg = body.frame_a.f / sprung_mass
  v_cg = MultibodyComponents.resolve2(body.frame_a.R, body.v_cm_0)

  # Connections
  connect(body.frame_a, rig) {^id22}
  connect(front_suspension.chassis, body.frame_a) {^id23}
  connect(rear_suspension.chassis, body.frame_a) {^id24}
  connect(front_suspension.wheel_left, corner_fl.wheel_center) {^id25}
  connect(front_suspension.wheel_right, corner_fr.wheel_center) {^id26}
  connect(rear_suspension.wheel_left, corner_rl.wheel_center) {^id27}
  connect(rear_suspension.wheel_right, corner_rr.wheel_center) {^id28}
  connect(rig, aero.chassis) {^id29}
  connect(rig, body_angles.frame_a) {^id30}

metadata {
  "Dyad": {
    "panel": {
      "control": "tabs",
      "children": {
        "Vehicle": {
          "contents": ["vehicle_name"]
        },
        "Sprung mass": {
          "contents": ["sprung_mass", "sprung_I_11", "sprung_I_22", "sprung_I_33", "sprung_cg"]
        },
        "Brakes": {"contents": ["brake_bias", "max_brake_torque"]},
        "Damper curves": {
          "contents": [
            "heave_damper_compression_front",
            "heave_damper_extension_front",
            "roll_damper_compression_front",
            "roll_damper_extension_front",
            "heave_damper_compression_rear",
            "heave_damper_extension_rear",
            "roll_damper_compression_rear",
            "roll_damper_extension_rear"
          ]
        },
        "Road realization": {"contents": ["road_N", "road_seed", "road_n_min", "road_n_max"]}
      }
    },
