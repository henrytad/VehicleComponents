component FullVehicle
  """
  Full vehicle

  The `rig` frame is the sprung mass reference. Attach it to ground through
  whatever DOF the study needs.
  """

  rig = Dyad.Frame3D() {^rig}
  
  # Sprung mass
  body = MultibodyComponents.Body(
    m = sprung_mass,
    r_cm = sprung_cg,
    I_11 = sprung_I_11,
    I_22 = sprung_I_22,
    I_33 = sprung_I_33,
    cylinder_radius = 0
  ) {^body}

  # Corners
  corner_fl = VehicleComponents.CornerAssembly(
    drive_gear_ratio = drive_gear_ratio
  ) {^corner_fl}
  corner_fr = VehicleComponents.CornerAssembly(
    drive_gear_ratio = drive_gear_ratio
  ) {^corner_fr}
  corner_rl = VehicleComponents.CornerAssembly(
    drive_gear_ratio = drive_gear_ratio
  ) {^corner_rl}
  corner_rr = VehicleComponents.CornerAssembly(
    drive_gear_ratio = drive_gear_ratio
  ) {^corner_rr}

  # Axles
  front_suspension = VehicleComponents.Suspension() {^front_suspension}
  rear_suspension = VehicleComponents.Suspension() {^rear_suspension}

  # Sprung mass properties
  parameter sprung_mass::Mass
  parameter sprung_I_11::Inertia
  parameter sprung_I_22::Inertia
  parameter sprung_I_33::Inertia
  parameter sprung_cg::Position[3]

  # Drive
  parameter drive_gear_ratio::Real = 1.0

relations

  # Sprung mass
  connect(body.frame_a, rig) {^id15}
  connect(front_suspension.chassis, body.frame_a) {^id13}
  connect(rear_suspension.chassis, body.frame_a) {^id14}

  # Corners to suspension
  connect(front_suspension.wheel_left, corner_fl.wheel_center) {^id9}
  connect(front_suspension.wheel_right, corner_fr.wheel_center) {^id10}
  connect(rear_suspension.wheel_left, corner_rl.wheel_center) {^id11}
  connect(rear_suspension.wheel_right, corner_rr.wheel_center) {^id12}

metadata {
