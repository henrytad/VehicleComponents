component FullVehicle
  """
  Full vehicle
  
  The `rig` frame is the sprung mass reference. Attach it to ground through
  whatever DOF the study needs.
  
  The vehicle takes a single `throttle` request and `control` decides what each 
  hub motor gets.
  """

  throttle = RealInput() {^throttle}
  brake = RealInput(units = "1") {^brake}
  steer = RealInput(units = "rad") {^steer}

  rig = Dyad.Frame3D() {^rig}
  body = MultibodyComponents.Body(
    m = sprung_mass,
    r_cm = sprung_cg,
    I_11 = sprung_I_11,
    I_22 = sprung_I_22,
    I_33 = sprung_I_33,
    cylinder_radius = 0
  ) {^body}
  corner_fl = VehicleComponents.CornerAssembly(
    brake(
      final brake_bias = VehicleComponents.params.brakes.bias,
      final max_torque = VehicleComponents.params.brakes.max_torque
    ),
    is_left = true,
    is_front = true,
    upright_mass = VehicleComponents.params.suspension.front.geometry.linkages.left.upright.mass,
    upright_I_11 = VehicleComponents.params.suspension.front.geometry.linkages.left.upright.i_11,
    upright_I_22 = VehicleComponents.params.suspension.front.geometry.linkages.left.upright.i_22,
    upright_I_33 = VehicleComponents.params.suspension.front.geometry.linkages.left.upright.i_33
  ) {^corner_fl}
  corner_fr = VehicleComponents.CornerAssembly(
    brake(
      final brake_bias = VehicleComponents.params.brakes.bias,
      final max_torque = VehicleComponents.params.brakes.max_torque
    ),
    is_left = false,
    is_front = true,
    upright_mass = VehicleComponents.params.suspension.front.geometry.linkages.right.upright.mass,
    upright_I_11 = VehicleComponents.params.suspension.front.geometry.linkages.right.upright.i_11,
    upright_I_22 = VehicleComponents.params.suspension.front.geometry.linkages.right.upright.i_22,
    upright_I_33 = VehicleComponents.params.suspension.front.geometry.linkages.right.upright.i_33
  ) {^corner_fr}
  corner_rl = VehicleComponents.CornerAssembly(
    brake(
      final brake_bias = VehicleComponents.params.brakes.bias,
      final max_torque = VehicleComponents.params.brakes.max_torque
    ),
    is_left = true,
    is_front = false,
    upright_mass = VehicleComponents.params.suspension.rear.geometry.linkages.left.upright.mass,
    upright_I_11 = VehicleComponents.params.suspension.rear.geometry.linkages.left.upright.i_11,
    upright_I_22 = VehicleComponents.params.suspension.rear.geometry.linkages.left.upright.i_22,
    upright_I_33 = VehicleComponents.params.suspension.rear.geometry.linkages.left.upright.i_33
  ) {^corner_rl}
  corner_rr = VehicleComponents.CornerAssembly(
    brake(
      final brake_bias = VehicleComponents.params.brakes.bias,
      final max_torque = VehicleComponents.params.brakes.max_torque
    ),
    is_left = false,
    is_front = false,
    upright_mass = VehicleComponents.params.suspension.rear.geometry.linkages.right.upright.mass,
    upright_I_11 = VehicleComponents.params.suspension.rear.geometry.linkages.right.upright.i_11,
    upright_I_22 = VehicleComponents.params.suspension.rear.geometry.linkages.right.upright.i_22,
    upright_I_33 = VehicleComponents.params.suspension.rear.geometry.linkages.right.upright.i_33
  ) {^corner_rr}
  front_suspension = VehicleComponents.Suspension(
    wheel_center_left = VehicleComponents.params.suspension.front.geometry.linkages.left.wheel_center,
    wheel_center_right = VehicleComponents.params.suspension.front.geometry.linkages.right.wheel_center,
    pushrod_outer_left = VehicleComponents.params.suspension.front.geometry.linkages.left.pushrod_outer,
    pushrod_outer_right = VehicleComponents.params.suspension.front.geometry.linkages.right.pushrod_outer,
    tierod_inner_left = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_inner,
    tierod_inner_right = VehicleComponents.params.suspension.front.geometry.linkages.right.tierod_inner,
    linkage_left(
      lca_front = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_front,
      lca_rear = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_rear,
      lca_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_outer,
      uca_front = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_front,
      uca_rear = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_rear,
      uca_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_outer,
      tierod_inner = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_inner,
      tierod_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_outer,
      static_camber = VehicleComponents.params.suspension.front.setup.alignment.left.static_camber,
      static_toe = VehicleComponents.params.suspension.front.setup.alignment.left.static_toe
    ),
    linkage_right(
      lca_front = VehicleComponents.params.suspension.front.geometry.linkages.right.lca_front,
      lca_rear = VehicleComponents.params.suspension.front.geometry.linkages.right.lca_rear,
      lca_outer = VehicleComponents.params.suspension.front.geometry.linkages.right.lca_outer,
      uca_front = VehicleComponents.params.suspension.front.geometry.linkages.right.uca_front,
      uca_rear = VehicleComponents.params.suspension.front.geometry.linkages.right.uca_rear,
      uca_outer = VehicleComponents.params.suspension.front.geometry.linkages.right.uca_outer,
      tierod_inner = VehicleComponents.params.suspension.front.geometry.linkages.right.tierod_inner,
      tierod_outer = VehicleComponents.params.suspension.front.geometry.linkages.right.tierod_outer,
      static_camber = VehicleComponents.params.suspension.front.setup.alignment.right.static_camber,
      static_toe = VehicleComponents.params.suspension.front.setup.alignment.right.static_toe
    ),
    inboard(
      rocker_pivot_left = VehicleComponents.params.suspension.front.geometry.inboard.rocker_pivot.left,
      rocker_pivot_right = VehicleComponents.params.suspension.front.geometry.inboard.rocker_pivot.right,
      pushrod_inner_left = VehicleComponents.params.suspension.front.geometry.inboard.pushrod_inner.left,
      pushrod_inner_right = VehicleComponents.params.suspension.front.geometry.inboard.pushrod_inner.right,
      heave_pickup_left = VehicleComponents.params.suspension.front.geometry.inboard.heave_pickup.left,
      heave_pickup_right = VehicleComponents.params.suspension.front.geometry.inboard.heave_pickup.right,
      roll_pickup_left = VehicleComponents.params.suspension.front.geometry.inboard.roll_pickup.left,
      roll_pickup_right = VehicleComponents.params.suspension.front.geometry.inboard.roll_pickup.right,
      pushrod_adjust_left = VehicleComponents.params.suspension.front.setup.pushrod_adjust.left,
      pushrod_adjust_right = VehicleComponents.params.suspension.front.setup.pushrod_adjust.right,
      heave_strut(
        spring(
          c = VehicleComponents.params.suspension.front.setup.heave.stiffness,
          s_unstretched = VehicleComponents.params.suspension.front.setup.heave.s_unstretched,
          perch_height = VehicleComponents.params.suspension.front.setup.heave.perch_height
        )
      ),
      roll_strut(
        spring(
          c = VehicleComponents.params.suspension.front.setup.roll.stiffness,
          s_neutral = VehicleComponents.params.suspension.front.setup.roll.s_neutral,
          preload_travel = VehicleComponents.params.suspension.front.setup.roll.preload_travel
        )
      )
    ),
    heave_dataset = VehicleComponents.damper_dataset(VehicleComponents.params.suspension.front.setup.heave.damper),
    roll_dataset = VehicleComponents.damper_dataset(VehicleComponents.params.suspension.front.setup.roll.damper)
  ) {^front_suspension}
  rear_suspension = VehicleComponents.Suspension(
    wheel_center_left = VehicleComponents.params.suspension.rear.geometry.linkages.left.wheel_center,
    wheel_center_right = VehicleComponents.params.suspension.rear.geometry.linkages.right.wheel_center,
    pushrod_outer_left = VehicleComponents.params.suspension.rear.geometry.linkages.left.pushrod_outer,
    pushrod_outer_right = VehicleComponents.params.suspension.rear.geometry.linkages.right.pushrod_outer,
    tierod_inner_left = VehicleComponents.params.suspension.rear.geometry.linkages.left.tierod_inner,
    tierod_inner_right = VehicleComponents.params.suspension.rear.geometry.linkages.right.tierod_inner,
    linkage_left(
      lca_front = VehicleComponents.params.suspension.rear.geometry.linkages.left.lca_front,
      lca_rear = VehicleComponents.params.suspension.rear.geometry.linkages.left.lca_rear,
      lca_outer = VehicleComponents.params.suspension.rear.geometry.linkages.left.lca_outer,
      uca_front = VehicleComponents.params.suspension.rear.geometry.linkages.left.uca_front,
      uca_rear = VehicleComponents.params.suspension.rear.geometry.linkages.left.uca_rear,
      uca_outer = VehicleComponents.params.suspension.rear.geometry.linkages.left.uca_outer,
      tierod_inner = VehicleComponents.params.suspension.rear.geometry.linkages.left.tierod_inner,
      tierod_outer = VehicleComponents.params.suspension.rear.geometry.linkages.left.tierod_outer,
      static_camber = VehicleComponents.params.suspension.rear.setup.alignment.left.static_camber,
      static_toe = VehicleComponents.params.suspension.rear.setup.alignment.left.static_toe
    ),
    linkage_right(
      lca_front = VehicleComponents.params.suspension.rear.geometry.linkages.right.lca_front,
      lca_rear = VehicleComponents.params.suspension.rear.geometry.linkages.right.lca_rear,
      lca_outer = VehicleComponents.params.suspension.rear.geometry.linkages.right.lca_outer,
      uca_front = VehicleComponents.params.suspension.rear.geometry.linkages.right.uca_front,
      uca_rear = VehicleComponents.params.suspension.rear.geometry.linkages.right.uca_rear,
      uca_outer = VehicleComponents.params.suspension.rear.geometry.linkages.right.uca_outer,
      tierod_inner = VehicleComponents.params.suspension.rear.geometry.linkages.right.tierod_inner,
      tierod_outer = VehicleComponents.params.suspension.rear.geometry.linkages.right.tierod_outer,
      static_camber = VehicleComponents.params.suspension.rear.setup.alignment.right.static_camber,
      static_toe = VehicleComponents.params.suspension.rear.setup.alignment.right.static_toe
    ),
    inboard(
      rocker_pivot_left = VehicleComponents.params.suspension.rear.geometry.inboard.rocker_pivot.left,
      rocker_pivot_right = VehicleComponents.params.suspension.rear.geometry.inboard.rocker_pivot.right,
      pushrod_inner_left = VehicleComponents.params.suspension.rear.geometry.inboard.pushrod_inner.left,
      pushrod_inner_right = VehicleComponents.params.suspension.rear.geometry.inboard.pushrod_inner.right,
      heave_pickup_left = VehicleComponents.params.suspension.rear.geometry.inboard.heave_pickup.left,
      heave_pickup_right = VehicleComponents.params.suspension.rear.geometry.inboard.heave_pickup.right,
      roll_pickup_left = VehicleComponents.params.suspension.rear.geometry.inboard.roll_pickup.left,
      roll_pickup_right = VehicleComponents.params.suspension.rear.geometry.inboard.roll_pickup.right,
      pushrod_adjust_left = VehicleComponents.params.suspension.rear.setup.pushrod_adjust.left,
      pushrod_adjust_right = VehicleComponents.params.suspension.rear.setup.pushrod_adjust.right,
      heave_strut(
        spring(
          c = VehicleComponents.params.suspension.rear.setup.heave.stiffness,
          s_unstretched = VehicleComponents.params.suspension.rear.setup.heave.s_unstretched,
          perch_height = VehicleComponents.params.suspension.rear.setup.heave.perch_height
        )
      ),
      roll_strut(
        spring(
          c = VehicleComponents.params.suspension.rear.setup.roll.stiffness,
          s_neutral = VehicleComponents.params.suspension.rear.setup.roll.s_neutral,
          preload_travel = VehicleComponents.params.suspension.rear.setup.roll.preload_travel
        )
      )
    ),
    heave_dataset = VehicleComponents.damper_dataset(VehicleComponents.params.suspension.rear.setup.heave.damper),
    roll_dataset = VehicleComponents.damper_dataset(VehicleComponents.params.suspension.rear.setup.roll.damper)
  ) {^rear_suspension}
  control = VehicleComponents.VehicleControl() {^control}
  aero = VehicleComponents.AeroLoad() {^aero}
  body_angles = MultibodyComponents.AbsoluteAngles(sequence = [3, 2, 1]) {^body_angles}

  # Sprung mass properties
  parameter sprung_mass::Mass = VehicleComponents.params.body.mass
  parameter sprung_I_11::Inertia = VehicleComponents.params.body.i_11
  parameter sprung_I_22::Inertia = VehicleComponents.params.body.i_22
  parameter sprung_I_33::Inertia = VehicleComponents.params.body.i_33
  parameter sprung_cg::Position[3] = VehicleComponents.params.body.cg

  variable w_cg::Angle[3]
  variable a_cg::Acceleration[3]
  variable v_cg::Velocity[3]

relations

  # Measurements
  w_cg = body_angles.angles
  a_cg = body.frame_a.f / sprung_mass
  v_cg = MultibodyComponents.resolve2(body.frame_a.R, body.v_cm_0)

  # Sprung mass
  connect(body.frame_a, rig) {^id15}
  connect(front_suspension.chassis, body.frame_a) {^id16}
  connect(rear_suspension.chassis, body.frame_a) {^id17}

  # Corners to suspension
  connect(front_suspension.wheel_left, corner_fl.wheel_center) {^id18}
  connect(front_suspension.wheel_right, corner_fr.wheel_center) {^id19}
  connect(rear_suspension.wheel_left, corner_rl.wheel_center) {^id20}
  connect(rear_suspension.wheel_right, corner_rr.wheel_center) {^id21}

  # Vehicle control
  connect(corner_fl.slip, control.slip_fl) {^id22}
  connect(corner_fr.slip, control.slip_fr) {^id23}
  connect(corner_rl.slip, control.slip_rl) {^id24}
  connect(corner_rr.slip, control.slip_rr) {^id25}
  connect(control.demand_fl, corner_fl.motor_demand) {^id26}
  connect(control.demand_fr, corner_fr.motor_demand) {^id27}
  connect(control.demand_rl, corner_rl.motor_demand) {^id28}
  connect(control.demand_rr, corner_rr.motor_demand) {^id29}
  connect(throttle, control.throttle) {^id30}

  # Brakes
  connect(brake, control.brake) {^id31}
  connect(control.brake_demand, corner_fl.brake_demand) {^id32}
  connect(control.brake_demand, corner_fr.brake_demand) {^id33}
  connect(control.brake_demand, corner_rl.brake_demand) {^id34}
  connect(control.brake_demand, corner_rr.brake_demand) {^id35}
  connect(rig, aero.chassis) {^id36}

  # Steering
  rear_suspension.steer = 0
  connect(steer, front_suspension.steer) {^id37}

  # Attitude sensor
  connect(rig, body_angles.frame_a) {^id38}

