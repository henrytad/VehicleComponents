component FullVehicle
  """
  Full vehicle

  The `rig` frame is the sprung mass reference. Attach it to ground through
  whatever DOF the study needs.

  The vehicle takes a single `throttle` request and `control` decides what each 
  hub motor gets.
  """

  throttle = RealInput() {^throttle}
  steer = RealInput(units = "rad") {^steer}

  rig = Dyad.Frame3D() {^rig}
  body = MultibodyComponents.Body(
    m = sprung_mass,
    r_cm = sprung_cg,
    I_11 = sprung_I_11,
    I_22 = sprung_I_22,
    I_33 = sprung_I_33,
    cylinder_radius = 0
  ) {^body}
  corner_fl = VehicleComponents.CornerAssembly(is_left = true) {^corner_fl}
  corner_fr = VehicleComponents.CornerAssembly(is_left = false) {^corner_fr}
  corner_rl = VehicleComponents.CornerAssembly(is_left = true) {^corner_rl}
  corner_rr = VehicleComponents.CornerAssembly(is_left = false) {^corner_rr}
  front_suspension = VehicleComponents.Suspension() {^front_suspension}
  rear_suspension = VehicleComponents.Suspension() {^rear_suspension}
  control = VehicleComponents.TorqueControlLaunch() {^control}
  aero = VehicleComponents.AeroLoad() {^aero}
  body_angles = MultibodyComponents.AbsoluteAngles(sequence = [3, 2, 1]) {^body_angles}

  # Sprung mass properties
  parameter sprung_mass::Mass
  parameter sprung_I_11::Inertia
  parameter sprung_I_22::Inertia
  parameter sprung_I_33::Inertia
  parameter sprung_cg::Position[3]

  variable w_cg::Angle[3]
  variable a_cg::Acceleration[3]

relations

  # Measurements
  w_cg = body_angles.angles
  a_cg = body.frame_a.f / sprung_mass

  # Sprung mass
  connect(body.frame_a, rig) {^id14}
  connect(front_suspension.chassis, body.frame_a) {^id15}
  connect(rear_suspension.chassis, body.frame_a) {^id16}

  # Corners to suspension
  connect(front_suspension.wheel_left, corner_fl.wheel_center) {^id17}
  connect(front_suspension.wheel_right, corner_fr.wheel_center) {^id18}
  connect(rear_suspension.wheel_left, corner_rl.wheel_center) {^id19}
  connect(rear_suspension.wheel_right, corner_rr.wheel_center) {^id20}

  # Torque control
  connect(corner_fl.slip, control.slip_fl) {^id21}
  connect(corner_fr.slip, control.slip_fr) {^id22}
  connect(corner_rl.slip, control.slip_rl) {^id23}
  connect(corner_rr.slip, control.slip_rr) {^id24}
  connect(control.tau_fl, corner_fl.tau_cmd) {^id25}
  connect(control.tau_fr, corner_fr.tau_cmd) {^id26}
  connect(control.tau_rl, corner_rl.tau_cmd) {^id27}
  connect(control.tau_rr, corner_rr.tau_cmd) {^id28}
  connect(throttle, control.throttle) {^id29}
  connect(rig, aero.chassis) {^id30}

  # Steering
  rear_suspension.steer = 0
  connect(steer, front_suspension.steer) {^id31}

  # Attitude sensor
  connect(rig, body_angles.frame_a) {^id32}

