component HubMotor
  """
  Outboard motor: torque source with its reaction carried by the structure it
  is bolted to.

  Takes a 0 to 1 torque demand and reports the mechanical power magnitude
  at full demand and the current wheel speed to vehicle control.
  """

  inputs = HubMotorInputs() {^inputs}
  outputs = HubMotorOutputs() {^outputs}

  wheel_center = Dyad.Frame3D() {^wheel_center}
  spline = Dyad.Spline() {^spline}

  parameter gear_ratio::Real
  parameter max_torque::Torque

  final parameter max_wheel_torque::Torque = max_torque * gear_ratio

  variable omega::AngularVelocity
  variable tau_motor::Torque
  variable tau_wheel::Torque
  variable power::Power

relations

  # Outputs
  outputs.omega = omega
  outputs.tau_motor = tau_motor
  outputs.tau_wheel = tau_wheel
  outputs.power = power
  outputs.full_demand_power = max_wheel_torque * abs(omega)

  # Equations
  omega = der(spline.phi)
  tau_wheel = inputs.demand * max_wheel_torque
  tau_motor = inputs.demand * max_torque
  power = tau_wheel * omega

  spline.tau = -tau_wheel
  wheel_center.f = [0, 0, 0]
  wheel_center.tau = [0, 1, 0] * tau_wheel

metadata {
