test component FullVehicleTestInertiaRoll
  """
  Inverted pendulum method for determining roll inertia.
  """
  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}
  mount = MultibodyComponents.FixedTranslation(r = pivot + [0, 0, ground_clearance], render = false) {^mount}
  roll_joint = MultibodyComponents.Revolute(n = [1, 0, 0], n_nonzero = [true, false, false], render = false) {^roll_joint}
  roll_spring = RotationalComponents.Components.Spring(c = roll_stiffness, phi_rel0 = 0.0) {^roll_spring}
  rig_offset = MultibodyComponents.FixedTranslation(r = -pivot, render = false) {^rig_offset}
  lock_fl = RotationalComponents.Components.Fixed() {^lock_fl}
  lock_fr = RotationalComponents.Components.Fixed() {^lock_fr}
  lock_rl = RotationalComponents.Components.Fixed() {^lock_rl}
  lock_rr = RotationalComponents.Components.Fixed() {^lock_rr}

  throttle = BlockComponents.Sources.Constant(k = 0.0) {^throttle}
  brake = BlockComponents.Sources.Constant(k = 0.0) {^brake}
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}
  vehicle = VehicleComponents.InertiaFixtureVehicle(aero(CdA = 0.0, ClA = 0.0)) {^vehicle}

  parameter reference_cg::Position[3] = VehicleComponents.params.body.cg
  parameter pivot_depth::Length = 0.25
  parameter ground_clearance::Length = 0.3
  parameter roll_stiffness::RotationalSpringConstant = 1600.0
  parameter initial_roll::Angle = 0.035

  final parameter pivot::Position[3] = reference_cg - [0, 0, pivot_depth]

relations

  initial roll_joint.phi = initial_roll
  initial roll_joint.w = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.w = 0.0
  initial vehicle.front_suspension.steering_rack.rack_drive.v = 0.0
  initial vehicle.rear_suspension.steering_rack.rack_drive.v = 0.0

  connect(throttle.y, vehicle.throttle) {^id14}
  connect(brake.y, vehicle.brake) {^id15}
  connect(steer.y, vehicle.steer) {^id16}
  connect(world.frame_b, mount.frame_a) {^id17}
  connect(mount.frame_b, roll_joint.frame_a) {^id18}
  connect(roll_joint.support, roll_spring.spline_a) {^id19}
  connect(roll_joint.axis, roll_spring.spline_b) {^id20}
  connect(roll_joint.frame_b, rig_offset.frame_a) {^id21}
  connect(rig_offset.frame_b, vehicle.rig) {^id22}
  connect(lock_fl.spline, vehicle.restraint_fl) {^id23}
  connect(lock_fr.spline, vehicle.restraint_fr) {^id24}
  connect(lock_rl.spline, vehicle.restraint_rl) {^id25}
  connect(lock_rr.spline, vehicle.restraint_rr) {^id26}

metadata {
  "Dyad": {
    "tests": {
      "roll_release": {
        "stop": 0.75,
        "solver": "Rodas5P",
        "atol": {"roll_joint.phi": 0.009},
        "expect": {
          "signals": ["roll_joint.phi", "roll_joint.w"]
        }
      }
    }
  },
  "_links": {
