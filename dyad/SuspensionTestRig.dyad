test component SuspensionTestRig
  """
  Half car test rig.
 
  Both wheels are jacked vertically from their wheel center.
  """

  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}

  suspension = VehicleComponents.Suspension(
    wheel_center_left = wheel_center_left,
    wheel_center_right = wheel_center_right,
    pushrod_outer_left = pushrod_outer_left,
    pushrod_outer_right = pushrod_outer_right,
    tierod_inner_left = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_inner,
    tierod_inner_right = VehicleComponents.params.suspension.front.geometry.linkages.right.tierod_inner,
    linkage_left(
      lca_front = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_front,
      lca_rear = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_rear,
      lca_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_outer,
      uca_front = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_front,
      uca_rear = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_rear,
      uca_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_outer,
      tierod_inner = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_inner,
      tierod_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_outer,
      static_camber = VehicleComponents.params.suspension.front.setup.alignment.left.static_camber,
      static_toe = VehicleComponents.params.suspension.front.setup.alignment.left.static_toe
    ),
    linkage_right(
      lca_front = VehicleComponents.params.suspension.front.geometry.linkages.right.lca_front,
      lca_rear = VehicleComponents.params.suspension.front.geometry.linkages.right.lca_rear,
      lca_outer = VehicleComponents.params.suspension.front.geometry.linkages.right.lca_outer,
      uca_front = VehicleComponents.params.suspension.front.geometry.linkages.right.uca_front,
      uca_rear = VehicleComponents.params.suspension.front.geometry.linkages.right.uca_rear,
      uca_outer = VehicleComponents.params.suspension.front.geometry.linkages.right.uca_outer,
      tierod_inner = VehicleComponents.params.suspension.front.geometry.linkages.right.tierod_inner,
      tierod_outer = VehicleComponents.params.suspension.front.geometry.linkages.right.tierod_outer,
      static_camber = VehicleComponents.params.suspension.front.setup.alignment.right.static_camber,
      static_toe = VehicleComponents.params.suspension.front.setup.alignment.right.static_toe
    ),
    inboard(
      rocker_pivot_left = VehicleComponents.params.suspension.front.geometry.inboard.rocker_pivot.left,
      rocker_pivot_right = VehicleComponents.params.suspension.front.geometry.inboard.rocker_pivot.right,
      pushrod_inner_left = VehicleComponents.params.suspension.front.geometry.inboard.pushrod_inner.left,
      pushrod_inner_right = VehicleComponents.params.suspension.front.geometry.inboard.pushrod_inner.right,
      heave_pickup_left = VehicleComponents.params.suspension.front.geometry.inboard.heave_pickup.left,
      heave_pickup_right = VehicleComponents.params.suspension.front.geometry.inboard.heave_pickup.right,
      roll_pickup_left = VehicleComponents.params.suspension.front.geometry.inboard.roll_pickup.left,
      roll_pickup_right = VehicleComponents.params.suspension.front.geometry.inboard.roll_pickup.right,
      pushrod_adjust_left = VehicleComponents.params.suspension.front.setup.pushrod_adjust.left,
      pushrod_adjust_right = VehicleComponents.params.suspension.front.setup.pushrod_adjust.right,
      heave_strut(
        spring(
          c = VehicleComponents.params.suspension.front.setup.heave.stiffness,
          s_unstretched = VehicleComponents.params.suspension.front.setup.heave.s_unstretched,
          perch_height = VehicleComponents.params.suspension.front.setup.heave.perch_height
        )
      ),
      roll_strut(
        spring(
          c = VehicleComponents.params.suspension.front.setup.roll.stiffness,
          s_neutral = VehicleComponents.params.suspension.front.setup.roll.s_neutral,
          preload_travel = VehicleComponents.params.suspension.front.setup.roll.preload_travel
        )
      )
    ),
    heave_dataset = VehicleComponents.damper_dataset(VehicleComponents.params.suspension.front.setup.heave.damper),
    roll_dataset = VehicleComponents.damper_dataset(VehicleComponents.params.suspension.front.setup.roll.damper)
  ) {^suspension}

  # Left jack
  fixed_left = MultibodyComponents.Fixed(r = base_left, render = false) {^fixed_left}
  prismatic_left = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^prismatic_left}
  actuation_rod_left = MultibodyComponents.SphericalSpherical(r_0 = [0, 0, jack_rod_length], radius = 0.02, render = false) {^actuation_rod_left}
  wheel_position_left = TranslationalComponents.Sources.Position() {^wheel_position_left}
 
  # Right jack
  fixed_right = MultibodyComponents.Fixed(r = base_right, render = false) {^fixed_right}
  prismatic_right = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^prismatic_right}
  actuation_rod_right = MultibodyComponents.SphericalSpherical(r_0 = [0, 0, jack_rod_length], radius = 0.02, render = false) {^actuation_rod_right}
  wheel_position_right = TranslationalComponents.Sources.Position() {^wheel_position_right}
 
  # Shared references
  parameter wheel_center_left::Position[3] = VehicleComponents.params.suspension.front.geometry.linkages.left.wheel_center
  parameter wheel_center_right::Position[3] = VehicleComponents.params.suspension.front.geometry.linkages.right.wheel_center
  parameter pushrod_outer_left::Position[3] = VehicleComponents.params.suspension.front.geometry.linkages.left.pushrod_outer
  parameter pushrod_outer_right::Position[3] = VehicleComponents.params.suspension.front.geometry.linkages.right.pushrod_outer
 
  # Rig
  final parameter jack_rod_length::Length = 0.1
  final parameter base_left::Position[3] = wheel_center_left - [0, 0, jack_rod_length]
  final parameter base_right::Position[3] = wheel_center_right - [0, 0, jack_rod_length]
 
  # Excitation
  parameter heave_amplitude::Length = 0.0254
  parameter roll_amplitude::Length = 0.0
  parameter freq::Frequency = 0.5
 
relations

  initial wheel_position_left.v = 0.0
  initial wheel_position_right.v = 0.0
  initial suspension.steering_rack.rack_drive.v = 0.0
  guess suspension.linkage_left.lca_rev.phi = 0.0
  guess suspension.linkage_right.lca_rev.phi = 0.0

  wheel_position_left.s_ref = (heave_amplitude + roll_amplitude) * sin(2 * π * freq * time)
  wheel_position_right.s_ref = (heave_amplitude - roll_amplitude) * sin(2 * π * freq * time)
  suspension.steer = 0
 
  # Left jack
  connect(fixed_left.frame_b, prismatic_left.frame_a) {^id16}
  connect(prismatic_left.frame_b, actuation_rod_left.frame_a) {^id17}
  connect(prismatic_left.support, wheel_position_left.support) {^id20}
  connect(wheel_position_left.flange, prismatic_left.axis) {^id19}
 
  # Right jack
  connect(fixed_right.frame_b, prismatic_right.frame_a) {^id13}
  connect(prismatic_right.frame_b, actuation_rod_right.frame_a) {^id14}
  connect(prismatic_right.support, wheel_position_right.support) {^id15}
  connect(wheel_position_right.flange, prismatic_right.axis) {^id21}
 
  # Axle
  connect(world.frame_b, suspension.chassis) {^id11}
  connect(actuation_rod_left.frame_b, suspension.wheel_left) {^id12}
  connect(actuation_rod_right.frame_b, suspension.wheel_right) {^id18}

