component Brake
  """
  Friction brake at one corner.

  Takes a 0 to 1 pressure demand and applies a torque opposing wheel rotation,
  with the reaction carried by the upright.

  The torque tapers through tanh over `omega_eps` so that a brake held on at a
  standstill cannot drive the wheel backwards.

  `brake_bias` splits the fixed total between the axles.
  """

  inputs = BrakeInputs() {^inputs}
  outputs = BrakeOutputs() {^outputs}

  wheel_center = Dyad.Frame3D() {^wheel_center}
  spline = Dyad.Spline() {^spline}

  structural parameter is_front::Boolean

  parameter max_torque::Torque
  parameter brake_bias::Real
  parameter omega_eps::AngularVelocity
  
  final parameter bias_factor::Real = ifelse(is_front, 2 * brake_bias, 2 * (1 - brake_bias))

  variable omega::AngularVelocity
  variable tau_brake::Torque

relations

  # Outputs
  outputs.tau_brake = tau_brake

  # Equations
  omega = der(spline.phi)
  tau_brake = max_torque * bias_factor * inputs.brake_demand * tanh(omega / omega_eps)

  spline.tau = tau_brake

  wheel_center.f = [0, 0, 0]
  wheel_center.tau = [0, 1, 0] * (-tau_brake)

