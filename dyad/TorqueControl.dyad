partial component TorqueControl
  """Interface for a vehicle torque controller."""

  throttle = RealInput() {^throttle}
  slip_fl = RealInput() {^slip_fl}
  slip_fr = RealInput() {^slip_fr}
  slip_rl = RealInput() {^slip_rl}
  slip_rr = RealInput() {^slip_rr}

  demand_fl = RealOutput(units = "1") {^demand_fl}
  demand_fr = RealOutput(units = "1") {^demand_fr}
  demand_rl = RealOutput(units = "1") {^demand_rl}
  demand_rr = RealOutput(units = "1") {^demand_rr}

relations

