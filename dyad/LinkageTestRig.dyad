test component LinkageTestRig
  """
  Single-corner suspension test rig.
 
  Jacks the wheel through a sinusoidal travel sweep and records various
  signals against a stored reference trajectory.
  """
  # World and jack
  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}
  fixed = MultibodyComponents.Fixed(r = base, render = false) {^fixed}
  prismatic = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^prismatic}
  actuation_rod = MultibodyComponents.SphericalSpherical(r_0 = [0, 0, actuation_rod_length], render = false) {^actuation_rod}
  wheel_position = TranslationalComponents.Sources.Position() {^wheel_position}
  mount_tierod = MultibodyComponents.Fixed(r = tierod_inner, render = false) {^mount_tierod}

  # Linkage
  linkage = VehicleComponents.Linkage(
    lca_front = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_front,
    lca_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_outer,
    lca_rear = VehicleComponents.params.suspension.front.geometry.linkages.left.lca_rear,
    uca_front = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_front,
    uca_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_outer,
    uca_rear = VehicleComponents.params.suspension.front.geometry.linkages.left.uca_rear,
    tierod_inner = tierod_inner,
    tierod_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_outer,
    pushrod_outer = VehicleComponents.params.suspension.front.geometry.linkages.left.pushrod_outer,
    wheel_center = wheel_center,
    static_camber = VehicleComponents.params.suspension.front.setup.alignment.left.static_camber,
    static_toe = VehicleComponents.params.suspension.front.setup.alignment.left.static_toe
  ) {^linkage}

  parameter wheel_center::Position[3] = VehicleComponents.params.suspension.front.geometry.linkages.left.wheel_center
  parameter tierod_inner::Position[3] = VehicleComponents.params.suspension.front.geometry.linkages.left.tierod_inner
 
  # Rig hardware
  final parameter actuation_rod_length::Length = 0.1
  final parameter base::Position[3] = wheel_center - [0, 0, actuation_rod_length]
 
  # Excitation
  parameter stroke::Length = 0.0254
  parameter freq::Frequency = 0.5

relations

  initial wheel_position.v = 0.0
  guess linkage.lca_rev.phi = 0.0

  wheel_position.s_ref = stroke * sin(2 * π * freq * time)

  connect(fixed.frame_b, prismatic.frame_a) {^id7}
  connect(prismatic.frame_b, actuation_rod.frame_a) {^id8}
  connect(prismatic.support, wheel_position.support) {^id9}
  connect(wheel_position.flange, prismatic.axis) {^id10}
  connect(linkage.chassis, world.frame_b) {^id11}
  connect(linkage.wheel, actuation_rod.frame_b) {^id12}
  connect(mount_tierod.frame_b, linkage.steering_rack) {^id13}

metadata {
  "Dyad": {
    "experiments": {},
    "tests": {
      "sweep": {
        "stop": 2.0,
        "atol": {
          "linkage.camber": 1e-5,
          "linkage.toe": 1e-5,
          "linkage.wc_height": 1e-5
        },
        "expect": {
          "initial": {
            "linkage.camber": 0.0,
            "linkage.toe": 0.0,
            "linkage.wc_height": 0.0
          },
          "signals": ["linkage.camber", "linkage.toe", "linkage.wc_height"]
        }
      }
    },
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null
  },
  "_links": {
    "world": {
      "Dyad": {
        "placement": {
          "diagram": {"iconName": "default", "x1": 220, "y1": 130, "x2": 320, "y2": 230, "rot": 0}
        },
        "tags": []
      }
    },
    "fixed": {
