component AeroLoad
  """
  Aerodynamic drag and downforce.

  A pure force element. It carries no mass and applies a single resultant to the
  frame it is attached to.
  """

  extends Styles

  chassis = Dyad.Frame3D() {^chassis}

  parameter rho::Density = VehicleComponents.params.aero.rho
  parameter CdA::Area = VehicleComponents.params.aero.CdA
  parameter ClA::Area = VehicleComponents.params.aero.ClA
  parameter bal_f::Real = VehicleComponents.params.aero.balance_front
  parameter wheelbase::Length = VehicleComponents.Data.wheelbase(VehicleComponents.params)
  parameter v_min::Velocity = 0.5

  final parameter x_cop::Length = (1 - bal_f) * wheelbase
  final parameter cop::Position[3] = [-x_cop, 0, 0]

  variable x_ref::Length
  variable v::Velocity
  variable q::Pressure
  variable drag::Force
  variable downforce::Force
  variable downforce_front::Force
  variable downforce_rear::Force
  variable f_cop::Force[3]

relations

  x_ref = chassis.r_0[1]
  v = der(x_ref)
  q = 0.5 * rho * v ^ 2

  drag = CdA * q * tanh(v / v_min)
  downforce = ClA * q
  downforce_front = bal_f * downforce
  downforce_rear = (1 - bal_f) * downforce

  f_cop = chassis.R * [-drag, 0, -downforce]

  chassis.f = -f_cop
  chassis.tau = -LinearAlgebra.cross(cop, f_cop)

metadata {
  "_links": {
    "chassis": {
      "Dyad": {"placement": {"diagram": {"x1": -50, "x2": 50, "y1": 450, "y2": 550}}}
    }
  }
}
end
