component AeroLoad
  """
  Aerodynamic drag and downforce.

  A pure force element. It carries no mass and applies a single resultant to the
  frame it is attached to.
  """

  extends Styles

  outputs = AeroLoadOutputs() {^outputs}

  chassis = Dyad.Frame3D() {^chassis}

  parameter rho::Density
  parameter CdA::Area
  parameter ClA::Area
  parameter bal_f::Real
  parameter wheelbase::Length
  parameter v_min::Velocity

  final parameter x_cop::Length = (1 - bal_f) * wheelbase
  final parameter cop::Position[3] = [-x_cop, 0, 0]

  variable x_ref::Length
  variable y_ref::Length
  variable v_x::Velocity
  variable v_y::Velocity
  variable v::Velocity
  variable v_reg::Velocity
  variable q::Pressure
  variable drag::Force
  variable downforce::Force
  variable downforce_front::Force
  variable downforce_rear::Force
  variable f_cop::Force[3]

relations

  # Outputs
  outputs.q = q
  outputs.drag = drag
  outputs.downforce = downforce
  outputs.downforce_front = downforce_front
  outputs.downforce_rear = downforce_rear

  # Equations
  x_ref = chassis.r_0[1]
  y_ref = chassis.r_0[2]
  v_x = der(x_ref)
  v_y = der(y_ref)

  v = sqrt(v_x ^ 2 + v_y ^ 2)
  v_reg = sqrt(v ^ 2 + v_min ^ 2)
  q = 0.5 * rho * (v_x ^ 2 + v_y ^ 2)

  drag = CdA * q * v / v_reg
  downforce = ClA * q
  downforce_front = bal_f * downforce
  downforce_rear = (1 - bal_f) * downforce

  f_cop = chassis.R * [-CdA * q * v_x / v_reg, -CdA * q * v_y / v_reg, -downforce]

  chassis.f = -f_cop
  chassis.tau = -LinearAlgebra.cross(cop, f_cop)

metadata {
  "_links": {
    "chassis": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": -50,
            "x2": 50,
            "y1": 450,
            "y2": 550
          },
          "icon": {
            "x1": -50,
            "x2": 50,
            "y1": 450,
            "y2": 550
          }
        }
      }
    },
    "outputs": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 950,
            "x2": 1050,
            "y1": 20,
            "y2": 120
          },
          "icon": {
            "x1": 950.0,
            "y1": 100.0,
            "x2": 1050.0,
            "y2": 200.0
          }
        }
      }
    }
  },
  "Dyad": {
    "panel": {
      "control": "tabs",
      "children": {
        "Aerodynamics": {
          "contents": [
            "rho",
            "CdA",
            "ClA"
          ]
        },
        "Geometry": {
          "contents": [
            "bal_f",
            "wheelbase"
          ]
        },
        "Numerics": {
          "contents": [
            "v_min"
          ]
        }
      }
    },
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "layer": "icon"
      }
    ]
  }
}
end
