component WheelAssembly
  """
  Wheel assembly: tire and rim.

  Owns the rotating group. `TireMF61` is a pure force element, so both the rim
  and the tire inertias are collected here into a single `spin` inertia.
  """

  outputs = WheelAssemblyOutputs() {^outputs}

  spline = Dyad.Spline() {^spline}
  wheel_center = Dyad.Frame3D() {^wheel_center}
  tire = VehicleComponents.TireMF61() {^tire}
  spin = RotationalComponents.Components.Inertia(J = spin_inertia) {^spin}
  wheel_body = MultibodyComponents.Body(
    m = wheel_mass,
    r_cm = [0, 0, 0],
    I_11 = 0,
    I_22 = 0,
    I_33 = 0,
    cylinder_radius = 0
  ) {^wheel_body}

  parameter rim_mass::Mass
  parameter rim_inertia::Inertia
  parameter tire_mass::Mass
  parameter tire_inertia::Inertia

  final parameter wheel_mass::Mass = rim_mass + tire_mass
  final parameter spin_inertia::Inertia = rim_inertia + tire_inertia

relations

  # Outputs
  outputs.Fx = tire.outputs.Fx
  outputs.Fy = tire.outputs.Fy
  outputs.Fz = tire.outputs.Fz
  outputs.alpha = tire.outputs.alpha
  outputs.omega = tire.outputs.omega
  outputs.Re = tire.outputs.Re
  outputs.slip = tire.outputs.slip

  # Connections
  connect(wheel_center, tire.wheel_center) {^id7}
  connect(wheel_center, wheel_body.frame_a) {^id8}
  connect(spline, spin.spline_a) {^id9}
  connect(spin.spline_b, tire.spline) {^id10}

