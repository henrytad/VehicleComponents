test component FullVehicleTestStatic
  """
  Static settling test
  
  The sprung mass is held on a heave/roll/pitch stack. No lateral, longitudinal
  or yaw freedom. Released from the reference configuration. Gravity
  compresses the springs and tyres until the car reaches equilibrium.
  """

  world = MultibodyComponents.World(n = [0, 0, -1], render = false) {^world}

  throttle = BlockComponents.Sources.Constant(k = 0.0) {^throttle}
  steer = BlockComponents.Sources.Constant(k = 0.0) {^steer}

  heave_joint = MultibodyComponents.Prismatic(n = [0, 0, 1], render = false) {^heave_joint}
  roll_joint = MultibodyComponents.Revolute(n = [1, 0, 0], render = false) {^roll_joint}
  pitch_joint = MultibodyComponents.Revolute(n = [0, 1, 0], render = false) {^pitch_joint}

  vehicle = VehicleComponents.FullVehicle() {^vehicle}

relations

  initial heave_joint.s = 0.0
  initial heave_joint.v = 0.0
  initial roll_joint.phi = 0.0
  initial roll_joint.w = 0.0
  initial pitch_joint.phi = 0.0
  initial pitch_joint.w = 0.0
  initial vehicle.front_suspension.linkage_left.lca_rev.phi = 0.0
  initial vehicle.front_suspension.linkage_left.lca_rev.w = 0.0
  initial vehicle.front_suspension.linkage_right.lca_rev.phi = 0.0
  initial vehicle.front_suspension.linkage_right.lca_rev.w = 0.0
  initial vehicle.rear_suspension.linkage_left.lca_rev.phi = 0.0
  initial vehicle.rear_suspension.linkage_left.lca_rev.w = 0.0
  initial vehicle.rear_suspension.linkage_right.lca_rev.phi = 0.0
  initial vehicle.rear_suspension.linkage_right.lca_rev.w = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.phi = 0.0
  initial vehicle.corner_fl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_fr.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rl.wheel_assembly.spin.w = 0.0
  initial vehicle.corner_rr.wheel_assembly.spin.w = 0.0
  initial vehicle.front_suspension.steering_rack.rack_drive.v = 0.0
  initial vehicle.rear_suspension.steering_rack.rack_drive.v = 0.0

  connect(throttle.y, vehicle.throttle) {^id8}
  connect(steer.y, vehicle.steer) {^id9}
  connect(world.frame_b, heave_joint.frame_a) {^id10}
  connect(heave_joint.frame_b, roll_joint.frame_a) {^id11}
  connect(roll_joint.frame_b, pitch_joint.frame_a) {^id12}
  connect(pitch_joint.frame_b, vehicle.rig) {^id13}

metadata {
  "Dyad": {
    "experiments": {},
    "tests": {
      "settle": {
        "stop": 5,
        "atol": {
          "vehicle.corner_fl.wheel_assembly.tire.Fz": 0.5,
          "vehicle.corner_fr.wheel_assembly.tire.Fz": 0.5,
          "vehicle.corner_rl.wheel_assembly.tire.Fz": 0.5,
          "vehicle.corner_rr.wheel_assembly.tire.Fz": 0.5,
          "heave_joint.s": 0.00001,
          "pitch_joint.phi": 0.00001,
          "roll_joint.phi": 0.00001
        },
        "expect": {
          "initial": {
            "vehicle.corner_fl.wheel_assembly.tire.Fz": 0,
            "vehicle.corner_fr.wheel_assembly.tire.Fz": 0,
            "vehicle.corner_rl.wheel_assembly.tire.Fz": 0,
            "vehicle.corner_rr.wheel_assembly.tire.Fz": 0,
            "heave_joint.s": 0,
            "roll_joint.phi": 0,
            "pitch_joint.phi": 0
          },
          "signals": [
            "vehicle.corner_fl.wheel_assembly.tire.Fz",
            "vehicle.corner_fr.wheel_assembly.tire.Fz",
            "vehicle.corner_rl.wheel_assembly.tire.Fz",
            "vehicle.corner_rr.wheel_assembly.tire.Fz",
            "heave_joint.s",
            "roll_joint.phi",
            "pitch_joint.phi"
          ]
        }
      }
    },
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null
  },
  "_links": {
    "world": {"Dyad": {"placement": {"diagram": {"x1": 0, "y1": 10, "x2": 100, "y2": 110}}}},
    "throttle": {
      "Dyad": {"placement": {"diagram": {"x1": 30, "x2": 130, "y1": 330, "y2": 430}}}
    },
    "steer": {
