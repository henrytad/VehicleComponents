component RollSpring
  """
  Opposed bump-spring pack for a mode-decoupled roll element.

  Models the two bump springs of a roll damper, one per direction of roll, as a
  single double-acting line force. Force is zero at `s_neutral`, so the pack is
  unstretched at zero roll and carries load either way.
  """

  extends MultibodyComponents.PartialLineForce
  extends MultibodyComponents.Renderable

  outputs = RollSpringOutputs() {^outputs}

  # Visualization shape
  spring_shape = MultibodyComponents.SpringShape(render = render, color = color, num_windings = num_windings, N = N, end_ratio = end_ratio, r = frame_a.r_0, length_direction = r_rel_0, length = s, width = radius)

  "Rate of each bump spring"
  parameter c::TranslationalSpringConstant
  "Length at zero roll, where the pack carries no load"
  parameter s_neutral::Length
  "Shim preload per spring, as travel. 0 means the springs just touch"
  parameter preload_travel::Length
  "Radius in animations"
  final parameter radius::Length = 0.02
  "Number of windings in animations"
  final parameter num_windings::Real = 15.0
  "Number of points used to render each winding"
  final parameter N::Integer = 600
  "Fraction of total length used for the tapered ends"
  final parameter end_ratio::Real = 0.1
  "Deflection from the neutral length, positive in extension"
  variable x::Length

relations

  # Outputs
  outputs.s = s
  outputs.f = f

  # Equations
  x = s - s_neutral
  f = ifelse(x > preload_travel, c * (x + preload_travel), ifelse(x < -preload_travel, c * (x - preload_travel), 2 * c * x))

metadata {
  "_links": {
    "outputs": {
      "Dyad": {
        "placement": {
          "diagram": {
            "x1": 950.0,
            "y1": 20.0,
            "x2": 1050.0,
            "y2": 120.0
          },
          "icon": {
            "x1": 950.0,
            "y1": 100.0,
            "x2": 1050.0,
            "y2": 200.0
          }
        }
      }
    }
  },
  "Dyad": {
    "panel": {
      "control": "tabs",
      "children": {
        "Spring": {
          "contents": [
            "c",
