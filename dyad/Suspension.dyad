component Suspension
  """
  Half car suspension. 
  
  Two corner linkages driven into a shared heave/roll inboard.
  """

  inputs = SuspensionInputs() {^inputs}
  outputs = SuspensionOutputs() {^outputs}

  # External frames
  chassis = Dyad.Frame3D() {^chassis}
  wheel_left = Dyad.Frame3D() {^wheel_left}
  wheel_right = Dyad.Frame3D() {^wheel_right}

  # Subsystems
  inboard = VehicleComponents.Inboard(
    pushrod_outer_left = pushrod_outer_left,
    pushrod_outer_right = pushrod_outer_right,
    heave_dataset = heave_dataset,
    roll_dataset = roll_dataset
  ) {^inboard}
  linkage_left = VehicleComponents.Linkage(
    wheel_center = wheel_center_left,
    pushrod_outer = pushrod_outer_left
  ) {^linkage_left}
  linkage_right = VehicleComponents.Linkage(
    wheel_center = wheel_center_right,
    pushrod_outer = pushrod_outer_right
  ) {^linkage_right}
  steering_rack = VehicleComponents.SteeringRack(
    tierod_inner_left = tierod_inner_left,
    tierod_inner_right = tierod_inner_right
  ) {^steering_rack}

  # TODO: Remove dataset and color as pass through parameters once Dyad compiling is fixed
  structural parameter heave_dataset::DyadData.DyadTimeseries
  structural parameter roll_dataset::DyadData.DyadTimeseries

  # Shared references
  parameter wheel_center_left::Position[3]
  parameter wheel_center_right::Position[3]
  parameter pushrod_outer_left::Position[3]
  parameter pushrod_outer_right::Position[3]
  parameter tierod_inner_left::Position[3]
  parameter tierod_inner_right::Position[3]

  # Outputs
  variable wc_heave::Dyad.Length
  variable wc_roll::Dyad.Length

relations

  # Inputs
  steering_rack.inputs.steer = inputs.steer

  # Outputs
  outputs.wc_heave = wc_heave
  outputs.wc_roll = wc_roll
  outputs.s_heave = inboard.outputs.s_heave
  outputs.f_heave = inboard.outputs.f_heave
  outputs.s_roll = inboard.outputs.s_roll
  outputs.f_roll = inboard.outputs.f_roll
  outputs.toe_left = linkage_left.outputs.toe
  outputs.camber_left = linkage_left.outputs.camber
  outputs.wc_height_left = linkage_left.outputs.wc_height
  outputs.f_lca_left = linkage_left.outputs.f_lca
  outputs.f_uca_left = linkage_left.outputs.f_uca
  outputs.f_push_left = linkage_left.outputs.f_push
  outputs.f_uca_ball_left = linkage_left.outputs.f_uca_ball
  outputs.toe_right = linkage_right.outputs.toe
  outputs.camber_right = linkage_right.outputs.camber
  outputs.wc_height_right = linkage_right.outputs.wc_height
  outputs.f_lca_right = linkage_right.outputs.f_lca
  outputs.f_uca_right = linkage_right.outputs.f_uca
  outputs.f_push_right = linkage_right.outputs.f_push
  outputs.f_uca_ball_right = linkage_right.outputs.f_uca_ball

  # Equations
  wc_heave = (linkage_left.outputs.wc_height + linkage_right.outputs.wc_height) / 2
  wc_roll = (linkage_left.outputs.wc_height - linkage_right.outputs.wc_height) / 2

  # Chassis
  connect(linkage_left.chassis, chassis) {^id9}
  connect(linkage_right.chassis, chassis) {^id10}
  connect(inboard.chassis, chassis) {^id11}

  # Linkages and inboard
  connect(linkage_left.pushrod, inboard.linkage_left) {^id12}
  connect(linkage_right.pushrod, inboard.linkage_right) {^id13}

  # Wheels
  connect(linkage_left.wheel, wheel_left) {^id14}
  connect(linkage_right.wheel, wheel_right) {^id15}

  # Steering
  connect(chassis, steering_rack.chassis) {^id16}
  connect(steering_rack.tie_rod_left, linkage_left.steering_rack) {^id17}
  connect(steering_rack.tie_rod_right, linkage_right.steering_rack) {^id18}

