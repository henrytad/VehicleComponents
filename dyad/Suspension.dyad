component Suspension
  """
  Half car suspension. 
  
  Two corner linkages driven into a shared heave/roll inboard.
  """

  # External frames
  chassis = Dyad.Frame3D() {^chassis}
  wheel_left = Dyad.Frame3D() {^wheel_left}
  wheel_right = Dyad.Frame3D() {^wheel_right}

  # Subsystems
  inboard = VehicleComponents.Inboard(
    pushrod_outer_left = pushrod_outer_left,
    pushrod_outer_right = pushrod_outer_right
  ) {^inboard}
  linkage_left = VehicleComponents.Linkage(
    wheel_center = wheel_center_left,
    pushrod_outer = pushrod_outer_left
  ) {^linkage_left}
  linkage_right = VehicleComponents.Linkage(
    wheel_center = wheel_center_right,
    pushrod_outer = pushrod_outer_right
  ) {^linkage_right}
  
  # Shared referencese
  parameter wheel_center_left::Position[3]
  parameter wheel_center_right::Position[3]
  parameter pushrod_outer_left::Position[3]
  parameter pushrod_outer_right::Position[3]

  # Outputs
  variable wc_heave::Dyad.Length
  variable wc_roll::Dyad.Length

relations

  # Measurements
  wc_heave = (linkage_left.wc_height + linkage_right.wc_height) / 2
  wc_roll = (linkage_left.wc_height - linkage_right.wc_height) / 2

  # Chassis
  connect(linkage_left.chassis, chassis) {^id8}
  connect(linkage_right.chassis, chassis) {^id9}
  connect(inboard.chassis, chassis) {^id13}
 
  # Linkages and inboard
  connect(linkage_left.pushrod, inboard.linkage_left) {^id10}
  connect(linkage_right.pushrod, inboard.linkage_right) {^id12}
 
  # Wheels
  connect(linkage_left.wheel, wheel_left) {^id11}
  connect(linkage_right.wheel, wheel_right) {^id7}

