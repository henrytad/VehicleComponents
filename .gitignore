# Everything ignored unless explicitly allowed
/*

# Allowlist
!/.github/
!/.vscode/
!/dyad/
!/generated/
!/scripts/
!/src/
!/test/
!/.dockerignore
!/.gitignore
!/Dockerfile
!/Manifest.toml
!/Project.toml
!/README.md

# README media only. Vehicle and tyre data under assets/ stays ignored.
!/assets/
/assets/*
!/assets/media/
